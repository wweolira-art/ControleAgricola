# Porta da API em dev (8788 evita conflito com OpenIP em 127.0.0.1:8787)
PLANEJAMENTO_API_PORT=8788
# agricola = colheita/indicadores | custo = orçamento e cadastros
VITE_APP_FLAVOR=agricola

ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=host:1521/servico
ORACLE_CLIENT_LIB_DIR=C:\instantclient-basic-windows.x64-23.26.0.0.0\instantclient_23_0

# URLs ORDS para importação de entrada de cana (opcional — há valores padrão)
ORDS_ENTRADA_CANA_MAQUINA_URL=
ORDS_ENTRADA_CANA_CAMINHAO_URL=
ORDS_HORAS_MAQUINA_URL=
ORDS_FAZENDA_USINA_URL=
ORDS_COLHEITA_DIARIA_URL=https://g58645a2c384a96-bd1.adb.sa-saopaulo-1.oraclecloudapps.com/ords/admin/colheitadiaria/

# Login — API ORDS de usuários (senha validada com SHA-256 no servidor)
ORDS_BASE_URL=https://g58645a2c384a96-bd1.adb.sa-saopaulo-1.oraclecloudapps.com/ords/admin
# ORDS_USUARIO_URL=https://.../ords/admin/usuario/
# AUTH_SECRET=defina-um-segredo-forte-em-producao

# -----------------------------------------------------------------------------
# Chat IA — pasta agro-assistente/ | .env compartilhado na raiz deste projeto
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PLANEJAMENTO_API_URL=http://localhost:8788/api

# Proxy Vite /ai → :3000 em dev; sobrescreva em produção
# VITE_CHAT_URL=http://localhost:3000
# npm run dev sobe API (:8788), web (:5173) e Agro Assistente (:3000/:3443)
# OpenIP (OpenIP/server.mjs) usa 127.0.0.1:8787 — não altere para 8787 se o OpenIP estiver ativo.
