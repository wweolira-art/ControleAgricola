            "text": "<section drag-and-drop=\"move-modal-trigger\" ng-show=\"showModalHectaresDistributionOpen\" class=\"modal-hectares-distribution\">\n  <div class=\"col-md-12 actions-distribution\">\n    <a class=\"col-md-push-9 col-md-1\" id=\"move-modal-trigger\">\n      <i title=\"Mover Grafico\" class=\"fa fa-arrows-alt\" aria-hidden=\"true\"></i>\n    </a>\n    <a class=\"col-md-1 pull-right\" title=\"Fechar Grafico\" ng-click=\"closeDistribution()\">\n      <span class=\"fa fa-times\"></span>\n    </a>\n  </div>\n  <div class=\"distribution\" ng-if=\"showModalHectaresDistributionOpen\">\n    <div class=\"row\">\n      <p class=\"title col-md-12\"> Distribuição de Hectares</p>\n    </div>\n    <hectares-distribution datamap=\"currentDistribution\" title=\"Distribuição de Hectares\" visible=\"showSubTitle\" decimal-places=\"decimalPlaces\"></hectares-distribution>\n    <div class=\"col-md-12\">\n      <label class=\"switch\">\n        <input type=\"checkbox\" ng-click=\"showLegend()\">\n        <span class=\"slider round\"></span>\n      </label>\n    </div>\n  </div>\n</section>\n<version-verifier url=\"{{versionUrl}}\" version=\"1.4.2\"></version-verifier>\n"
