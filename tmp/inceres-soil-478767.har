          "content": {
            "size": 4896,
            "mimeType": "text/html",
            "text": "<div class=\"map\" ng-class=\"{'collapsed' : sidebarCollapsed}\" ng-controller=\"MapController\">\n\n  <div id=\"map-container\" class=\"map-container\">\n    <div id=\"popup\" class=\"\"></div>\n    <div id=\"pointsPopup\" class=\"\"></div>\n  </div>\n  <div id=\"ol-center-map\" class=\"ol-center-map\" data-hover=\"Centralizar Mapa\">\n    <i ng-click=\"centerMap()\" class=\"fa fa-arrows\"></i>\n  </div>\n  <div class=\"help-icon\" data-hover=\"Legenda\">\n    <i ng-click=\"toogleLegendPanel()\" class=\"fa fa-question legend-icon\"></i>\n  </div>\n  <div class=\"search-piece-icon\" data-hover=\"Buscar ponto\" ng-if=\"warehouse.pieces.length > 0\">\n    <i ng-click=\"toggleSearchPiecePanel()\" class=\"fa fa-search\"></i>\n  </div>\n\n  <div class=\"erase-piece-icon\" data-hover=\"Ver Id dos Pontos\" ng-if=\"warehouse.pieces.length > 0\">\n    <i ng-click=\"showDisplayId()\" class=\"fa fa-eye\"></i>\n  </div>\n\n  <div class=\"erase-piece-icon\" data-hover=\"Limpar Id dos Pontos\" ng-if=\"showIconToNotSeeDisplayId && warehouse.pieces.length > 0\">\n    <i ng-click=\"eraseDisplayId()\" class=\"fa fa-eye-slash\"></i>\n  </div>\n\n  <div class=\"erase-piece-icon\" data-hover=\"Ver Pontos\" ng-if=\"showIconToSee && seingMyTools\">\n    <i ng-click=\"showAllPoints()\" class=\"fa fa-eye\"></i>\n  </div>\n\n  <div class=\"erase-piece-icon\" data-hover=\"Limpar Pontos\" ng-if=\"showIconNotSee && seingMyTools\">\n    <i ng-click=\"erasePoints()\" class=\"fa fa-eye-slash\"></i>\n  </div>\n\n  <div class=\"legend-panel\" ng-if=\"showLegendPanel\">\n    <button type=\"button\" class=\"close-legends\" ng-click=\"closeLegendPanel()\" title=\"Fechar\" aria-label=\"Fechar legenda\">\n      <i class=\"fa fa-times\" aria-hidden=\"true\"></i>\n    </button>\n    <div class=\"container\">\n\n      <div class=\"row legend-panel-row\">\n        <div class=\"col-md-1 profundidades\">\n          (1)\n        </div>\n        <div class=\"col-md-2\">Uma profundidade</div>\n        <div class=\"col-md-1 cor-div\">\n          <div class=\"ponto-verde\">\n            <img class=\"ponto1\" src=\"../img/pontoVazio1.png\">\n          </div>\n        </div>\n        <div class=\"col-md-3 cor-label\">Todos os elementos corretos</div>\n      </div>\n\n      <div class=\"row legend-panel-row\">\n        <div class=\"col-md-1 profundidades\">\n          (2)\n        </div>\n        <div class=\"col-md-2\">Duas profundidades</div>\n        <div class=\"col-md-1 cor-div\">\n          <div class=\"ponto-amarelo\">\n            <img class=\"ponto1\" src=\"../img/pontoVazio1.png\">\n          </div>\n        </div>\n        <div class=\"col-md-3 cor-label\">Ponto contém elementos não solicitados</div>\n      </div>\n\n      <div class=\"row legend-panel-row\">\n        <div class=\"col-md-1 profundidades\">\n          (3)\n        </div>\n        <div class=\"col-md-2\">Três profundidades</div>\n        <div class=\"col-md-1 cor-div\">\n          <div class=\"ponto-laranja\">\n            <img class=\"ponto1\" src=\"../img/pontoVazio1.png\">\n          </div>\n        </div>\n        <div class=\"col-md-3 cor-label\">Um ou mais elementos solicitados faltando</div>\n      </div>\n\n      <div class=\"row legend-panel-row\">\n        <div class=\"col-md-1 profundidades\">\n          (4)\n        </div>\n        <div class=\"col-md-2\">Quatro profundidades</div>\n        <div class=\"col-md-1 cor-div\">\n          <div class=\"ponto-vermelho\">\n            <img class=\"ponto1\" src=\"../img/pontoVazio1.png\">\n          </div>\n        </div>\n        <div class=\"col-md-3 cor-label\">Não veio nenhum dos elementos solicitados</div>\n      </div>\n\n      <div class=\"row legend-panel-row legend-panel-row-audit\">\n        <div class=\"col-md-1 profundidades\">\n          <i class=\"fa fa-camera\" aria-hidden=\"true\"></i>\n        </div>\n        <div class=\"col-md-2\">Auditoria</div>\n        <div class=\"col-md-1 cor-div\">\n          <img class=\"ponto-auditoria\" src=\"../img/audit-camera-marker.svg\" alt=\"Ponto auditado\">\n        </div>\n        <div class=\"col-md-3 cor-label\">Ponto auditado destacado com marcador quadrado e ícone de câmera.</div>\n      </div>\n\n      <div class=\"row legend-panel-row\">\n        <div class=\"col-md-1 profundidades\">\n          <i class=\"fa fa-map-marker\" aria-hidden=\"true\"></i>\n        </div>\n        <div class=\"col-md-2\">Sem auditoria</div>\n        <div class=\"col-md-1 cor-div\">\n          <div class=\"ponto-verde\">\n            <img class=\"ponto1\" src=\"../img/pontoVazio1.png\">\n          </div>\n        </div>\n        <div class=\"col-md-3 cor-label\">Ponto sem ícone de câmera não exige foto de auditoria.</div>\n      </div>\n    </div>\n  </div>\n\n  <div ng-click=\"changeSatelliteLayer()\" class=\"map-layer-switch\">\n    <div ng-if=\"!satelliteLayerSelected\" class=\"bing\">Satélite</div>\n    <div ng-if=\"satelliteLayerSelected\" class=\"mapa\">Mapa</div>\n  </div>\n  <div ng-include=\"'templates/include/layer-visualizer-switch.html'\"></div>\n  <div ng-include=\"'templates/include/zone-fill-opacity-control.html'\"></div>\n</div>\n\n\n<version-verifier url=\"{{versionUrl}}\" version=\"2.1.0\" notify-outside=\"true\"/>\n"
          },
