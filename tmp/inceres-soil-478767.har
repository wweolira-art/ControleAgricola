            "text": "<div class=\"zone-fill-opacity-control\"\n     ng-if=\"prototypeBeingCreated && hasFilledZonesOnMap\"\n     ng-class=\"{'beside-zone-resume-table': showResumeTable}\"\n     ng-keydown=\"closePolygonFillOpacityPopoverOnEscape($event)\">\n  <button type=\"button\" class=\"button-tool-box zone-fill-opacity-toggle\" ng-class=\"{'activated': polygonFillOpacity.isPopoverOpen}\"\n          title=\"{{polygonFillOpacityButtonLabel()}}\" aria-label=\"{{polygonFillOpacityButtonLabel()}}\"\n          aria-expanded=\"{{polygonFillOpacity.isPopoverOpen}}\"\n          ng-attr-aria-controls=\"{{polygonFillOpacity.isPopoverOpen ? 'zone-fill-opacity-popover' : undefined}}\"\n          ng-click=\"togglePolygonFillOpacityPopover()\">\n    <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n      <path d=\"M1.92679e-06 8.1306C-0.0012638 6.292 0.621104 4.50732 1.7654 3.06821C2.9097 1.6291 4.50827 0.620651 6.29989 0.207647C8.09151 -0.205356 9.97023 0.00151063 11.6291 0.794443C13.2879 1.58738 14.6287 2.91949 15.4325 4.5731C16.5959 5.14027 17.607 5.97719 18.3816 7.01416C19.1562 8.05113 19.6718 9.25815 19.8856 10.5347C20.0993 11.8113 20.005 13.1204 19.6105 14.3531C19.2159 15.5859 18.5326 16.7065 17.6174 17.6217C16.7022 18.537 15.5815 19.2203 14.3488 19.6148C13.1161 20.0094 11.8069 20.1037 10.5304 19.8899C9.2538 19.6762 8.04678 19.1605 7.00981 18.386C5.97284 17.6114 5.13592 16.6003 4.56875 15.4369C3.19874 14.7699 2.04387 13.7312 1.23601 12.4393C0.428144 11.1474 -0.000159504 9.65431 1.92679e-06 8.1306ZM6.43 16.0781C7.02674 16.852 7.78162 17.4898 8.6443 17.949C9.50697 18.4081 10.4576 18.6781 11.4329 18.7408C12.4081 18.8036 13.3855 18.6577 14.2999 18.313C15.2144 17.9682 16.0448 17.4324 16.7358 16.7414C17.4268 16.0504 17.9626 15.22 18.3074 14.3055C18.6521 13.3911 18.798 12.4137 18.7352 11.4385C18.6725 10.4632 18.4025 9.51257 17.9434 8.64989C17.4842 7.78722 16.8464 7.03234 16.0725 6.4356C16.3555 7.7611