            "text": "<div class=\"custom-map\">\n  <ol-map boundary=\"boundary\" sidebar-behavior=\"sidebarBehavior\"></ol-map>\n  <div  id=\"demo\"></div>\n</div>\n<section ng-include=\"'templates/include/left-sidebar.html'\"></section>\n<section ng-include=\"'templates/equation-ide/pa-equation-ide.html'\" ng-if=\"operationType == 'PA'\"></section>\n<section ng-include=\"'templates/equation-ide/ca-equation-ide.html'\" ng-if=\"operationType == 'CA'\"></section>\n<section ng-include=\"'templates/include/modal-hectares-distribution.html'\"></section>\n\n<div ng-show=\"isCycleLoading\" class=\"full-screen-loader\" title=\"Aguarde até o carregamento terminar\">\n  <div class=\"wait-message\">\n    <span class=\"fa fa-spinner fa-spin\"></span>\n    <p>Aguarde...</p>\n    <h4 class=\"col-md-12\">Por favor, não atualize seu navegador até o carregamento terminar!</h4>\n  </div>\n</div>\n<div class=\"progress-status\" ng-style=\"backgroundProgress\" ng-class=\"{'im-alive': progressStatus.somethingIsHappenInTheSky}\">\n  <span ng-bind=\"progressStatus.message\"></span>\n  <span class=\"progress-timer\" ng-if=\"progressStatus.timer\">Tempo máximo estimado: <span ng-bind=\"progressStatus.timer | secondsToDateTime | date:'mm:ss'\"></span></span>\n</div>\n<version-verifier url=\"{{versionUrl}}\" version=\"1.4.2\"></version-verifier>\n"
