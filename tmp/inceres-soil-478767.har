          "cookies": [],
          "content": {
            "size": 4979,
            "mimeType": "text/html",
            "text": "<div ng-controller=\"NavbarController\" class=\"navbar-container column\">\n  <div class=\"navbar-logo\">\n    <a href=\"\"></a>\n  </div>\n  <div class=\"navbar-list\">\n    <div class=\"ui simple dropdown item\" ng-show=\"currentCycle != null\">\n      <small class=\"topmenu-text text\">Cliente:</small>\n      <span title=\"{{currentCycle.clientName}}\" class=\"topmenu-text text\">{{currentCycle.clientName | limitWithEllipsis: 12}}</span>\n    </div>\n    <div class=\"ui simple item\" ng-show=\"currentCycle != null\">\n      <small class=\"topmenu-text text\">Fazenda</small>\n      <span title=\"{{currentCycle.farmName}}\" class=\"topmenu-text text truncate\">{{currentCycle.farmName | limitWithEllipsis: 10}}</span>\n    </div>\n\n    <div class=\"ui simple item\" ng-show=\"currentCycle != null\">\n      <small class=\"topmenu-text text\">Ciclo</small>\n      <span title=\"{{currentCycle.name}}\" class=\"topmenu-text text truncate\">{{currentCycle.name | limitWithEllipsis: 10}}</span>\n    </div>\n\n    <div class=\"ui simple item\" ng-show=\"currentCycle != null\">\n      <small class=\"topmenu-text text\">Cultura:</small>\n      <span title=\"{{currentCycle.culture}}\" class=\"topmenu-text text truncate\">{{currentCycle.culture | limitWithEllipsis: 10}}</span>\n    </div>\n\n    <div class=\"ui simple item\" ng-show=\"currentCycle != null\">\n      <small class=\"topmenu-text text\">Ano:</small>\n      <span title=\"{{currentCycle.year}}\" class=\"topmenu-text text truncate\">{{currentCycle.year}}</span>\n    </div>\n    <div class=\"ui simple item\"  ng-show=\"currentCycle != null\" ng-click=\"clickShowAreas()\">\n      <small class=\"topmenu-text text\">Áreas:</small>\n      <span class=\"topmenu-text text truncate\">{{currentCycle.areas.length}} </span><i class=\"glyphicon glyphicon-chevron-down\"></i>\n    </div>\n\n    <div class=\"ui simple item\"  ng-show=\"currentCycle != null\">\n      <small class=\"topmenu-text text\">Ha:</small>\n      <span class=\"topmenu-text text truncate\">{{currentCycle.totalHa | number:2}}</span>\n    </div>\n    <div class=\"ui simple item\" ng-show=\"gridNumberOfPoints != null\">\n      <small class=\"topmenu-text text\">Pontos:</small>\n      <span class=\"topmenu-text text truncate\">{{gridNumberOfPoints}}</span>\n    </div>\n\n    <div class=\"ui simple item\">\n      <connection-status></connection-status>\n    </div>\n\n    <div class=\"ui simple  old-version\"\n         data-toggle=\"tooltip\"\n         data-placement=\"top\"\n         title=\"Você está utilizando uma versão desatualizada da plataforma. Aperte Ctrl + Shift + R para atualizar a página. Caso esta mensagem persista, limpe o cache do navegador.\"\n         ng-show=\"!isAppUpdated && isAppUpdated !== null\">\n      <small><i class=\"fa fa-exclamation-triangle exclamation-icon\" aria-hidden=\"true\"></i>  VERSÃO ANTIGA</small>\n    </div>\n  </div>\n\n  <div ng-if=\"showArea\" class=\"drop-count-areas-down\">\n    <div class=\"col-md-12\">\n      <a class=\"close\" ng-click=\"closeAreas()\">\n        <i class=\"glyphicon glyphicon-remove\"></i>\n      </a>\n    </div>\n    <ul>\n      <li ng-repeat=\"area in currentCycle.areas\">\n        <p>{{area.field | fieldFilter}} - {{area.block}} - {{area.ha}}ha</p>\n      </li>\n    </ul>\n  </div>\n\n  <a title=\"Voltar para o R+\" ng-if=\"isTuringOpen() && listProductivityState\" ui-sref=\"{{listProductivityState}}\" class=\"btn-back\"> <i class=\"fa fa-arrow-left\" aria-hidden=\"true\"></i></a>\n  <a title=\"Voltar para o R+\" ng-if=\"isTuringAsAppliedOpen() && listAsAppliedsState\" ui-sref=\"{{listAsAppliedsState}}\" class=\"btn-back\"> <i class=\"fa fa-arrow-left\" aria-hidden=\"true\"></i></a>\n  <a title=\"Voltar para o R+\" ng-if=\"isTuringElectricConductivityOpen()\" ui-sref=\"listPaElectricConductivityState\" class=\"btn-back\"> <i class=\"fa fa-arrow-left\" aria-hidden=\"true\"></i></a>\n  <a title=\"Voltar para o R+\" ng-if=\"isMotorsOpen() && (listFertilityState || cycleState)\" ui-sref=\"{{canIListFertilities ? listFertilityState : cycleState}}\" class=\"btn-back\"> <i class=\"fa fa-arrow-left\" aria-hidden=\"true\"></i></a>\n  <a title=\"Voltar para o R+\" ng-if=\"isXplorerOpen() && listSatImageState\" ui-sref=\"{{listSatImageState}}\" class=\"btn-back\"> <i class=\"fa fa-arrow-left\" aria-hidden=\"true\"></i></a>\n  <a title=\"Voltar para o R+\" ng-if=\"isAgrimensorOpen()\" ui-sref=\"openMotorsState\" class=\"btn-back\"> <i class=\"fa fa-arrow-left\" aria-hidden=\"true\"></i></a>\n\n  <div class=\"profile-settings\" title=\"Ajuda\">\n    <a data-toggle=\"dropdown\" aria-haspopup=\"true\" aria-expanded=\"false\">\n      <i class=\"glyphicon glyphicon-user\"></i>\n    </a>\n    <ul class=\"dropdown-menu\">\n      <li class=\"dropdown-submenu\">\n        <a ng-click=\"startTutorial()\">\n          <i class=\"fa fa-book\"></i> Tutorial\n        </a>\n      </li>\n      <li class=\"dropdown-submenu\">\n        <a ng-click=\"openFreshDeskChat()\">\n          <i class=\"fa fa-book\"></i> Chat Suporte\n        </a>\n      </li>\n    </ul>\n  </div>\n  <fresh-desk-chat open-chat=\"freshDeskChatHandler\"> </fresh-desk-chat>\n</div>\n<version-verifier url=\"{{versionUrl}}\" version=\"1.4.2\"></version-verifier>\n<api-status></api-status>\n"
          },
