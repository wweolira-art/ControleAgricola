          "content": {
            "size": 1483,
            "mimeType": "text/html",
            "text": "<div class=\"popup-depths\" ng-class=\"{'opened': showDepthsPopUp}\">\n    <div class=\"panel panel-default panel-depth-view\">\n        <div class=\"panel-body-depth\" ng-if=\"sendingData\">\n            <progress loading=\"sendingData\" class=\"spinner\"></progress>\n        </div>\n        <div class=\"panel-body-depth\" ng-if=\"!sendingData\">\n            <label>Ocorreu um erro ao identificar as profundidades, por favor nos ajude a identificar.</label>\n            <div ng-repeat=\"piece in missingPieces\">\n                <div class=\"row\">\n                    <div class=\"col-md-12 \">\n                        <div class=\"form-group\">\n                            <li>  Profundidade {{piece.index}}: </li>\n                            <select ng-model=\"piece.depth\" class=\"form-control\" >\n                                <option value=\"\">---Selecione uma Profundidade---</option>\n                                <option ng-repeat=\"depth in depthsList\">{{depth}}</option>\n                            </select>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"panel-footer\" ng-if=\"!sendingData\">\n            <button type=\"button\" class=\"btn btn-success\" ng-click=\"saveDepths(missingPieces)\">Salvar</button>\n            <button type=\"button\" class=\"btn btn-danger\" ng-click=\"closeDepths()\">Fechar</button>\n        </div>\n    </div>\n</div>\n<version-verifier url=\"{{versionUrl}}\" version=\"2.1.0\" notify-outside=\"true\"/>\n"
          },
          "redirectURL": "",
          "headersSize": -1,
          "bodySize": 0,
          "_transferSize": 0,
