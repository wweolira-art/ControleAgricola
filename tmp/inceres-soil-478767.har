          "content": {
            "size": 5443,
            "mimeType": "text/html",
            "text": "<div ng-controller=\"CarCreationController\" class=\"car-creation-div\">\n\n  <section ng-include=\"'templates/modal-car-prototype-pattern.html'\"></section>\n\n  <div class=\"car-config-div\" ng-class=\"{'visible': carCreationVisible}\" ng-if=\"showCarCreation\">\n    <div class=\"nav-bar-row\">\n      <ul class=\"nav nav-tabs\">\n        <li class=\"info-tool-tab\" ng-class=\"{'active': !gridPreferencesVisible}\"><a data-toggle=\"tab\" href=\"#gridData\" ng-click=\"changeGridCreationTabs(false)\">Dados</a></li>\n        <li class=\"info-tool-tab\" ng-class=\"{'active': gridPreferencesVisible}\" ng-if=\"canISetCarPreferences\"><a data-toggle=\"tab\" ng-href=\"#gridPreferences\" ng-click=\"changeGridCreationTabs(true)\">Preferências</a></li>\n      </ul>\n    </div>\n\n    <div id=\"gridData\" class=\"fade in active\" ng-if=\"!gridPreferencesVisible\">\n      <div class=\"info-top-full\">\n        <div class=\"info-top-form-row\">\n          <label>Nome:</label>\n          <input type=\"text\" ng-model=\"carPrototype.model\" class=\"form-control info-top-input\" required ng-disabled=\"editingGrid\">\n        </div>\n\n        <div class=\"info-top-form-row\" ng-if=\"loggedUser.whiteLabel.gridNeedLab\">\n          <label>Laboratório:</label>\n          <select ng-model=\"carPrototype.automaker\" class=\"form-control info-top-select\" required ng-options=\"automaker as automaker.legalPersonName for automaker in automakers\" ng-change=\"selectAutomaker()\">\n            <option value=\"\">- selecione -</option>\n          </select>\n        </div>\n\n        <div class=\"info-top-form-row\" ng-if=\"!editingGrid && !isLeafSampling()\">\n          <label>Padrão de Preferências de Análise:\n            <field-tooltip class=\"densidade-field\" text=\"Define as unidades dos elementos analisados, a ordem de exibição dos mapas de fertilidade e quais elementos serão apresentados nos relatórios.\" placement=\"bottom-left\"></field-tooltip>\n          </label>\n          <select ng-model=\"analysisPreferencePatternId\"  ng-change=\"selectAnalysisPreferencePatternId(analysisPreferencePatternId)\" class=\"form-control info-top-select\" ng-options=\"pattern.id as pattern.name for pattern in analysisPreferencesPatterns\" >\n          </select>\n        </div>\n\n        <section ng-include=\"'templates/include/grid-config-structure.html'\"></section>\n        <section ng-include=\"'templates/include/grid-config-sort.html'\"></section>\n      </div>\n\n      <div ng-if=\"anyPieceWasEdited\" class=\"edit-warning\">\n        ** Alterações nessa tabela serão aplicadas a todos os pontos\n      </div>\n    </div>\n\n    <section ng-include=\"'templates/include/grid-config-layers.html'\"></section>\n\n    <section ng-include=\"'templates/include/grid-config-preferences.html'\"></section>\n\n    <div class=\"config-buttons with-preferences\">\n      <button type=\"button\" class=\"btn btn-info send-pattern-alexandria\" ng-click=\"openCarPrototypePattern()\" title=\"Enviar grade como padrão para a biblioteca\"> <i  class=\"fa fa-book\" aria-hidden=\"true\"></i></button>\n      <button type=\"button\"  ng-if=\"!instaRecalc\" class=\"btn btn-primary recalc-random\" ng-click=\"recalcCarButtonClicked()\" title=\"Recalcular grade\"> <i class=\"fa fa-refresh\" ng-class=\"{'fa-spin' : recalcLoading}\" aria-hidden=\"true\"></i></button>\n      <button type=\"button\" class=\"btn btn-success\" ng-click=\"saveCar()\" title=\"Salvar grade\"><i class=\"fa fa-floppy-o\" aria-hidden=\"true\" title=\"Salvar grade\"></i></button>\n      <button type=\"button\" class=\"btn btn-danger\" ng-click=\"closeGridCreation()\" title=\"Fechar criação de grade\"> <i class=\"fa fa-times\" aria-hidden=\"true\"></i></button>\n    </div>\n  </div>\n\n  <div class=\"list-pieces-table\" ng-if=\"showPieceEditionPanel\" ng-class=\"{'visible': pieceEditionPanelVisible}\">\n    <div class=\"piece-selected-heading\">\n      <h3>Ponto selecionado: {{ pieceSelected.displayId }}</h3>\n      <h4 ng-if=\"(pieceSelected | describeSubPieces:carPrototype.subPieces)\">{{ pieceSelected | describeSubPieces:carPrototype.subPieces }}</h4>\n      <i class=\"fa fa-times close-icon\" ng-click=\"closePieceEditionPanel()\" aria-hidden=\"true\"></i>\n    </div>\n\n    <div class=\"piece-size-options-for-piece-edition\" ng-class=\"{'conventional-grid': showConventionalThings}\">\n      <div class=\"col-md-12\">\n        <button type=\"button\" ng-repeat=\"pieceIndex in piecesIndexAccepted\" ng-class=\"{'selected-prof' : sizeTabOpenEdition[pieceIndex]}\" ng-click=\"changeTabEdition(pieceIndex)\" class=\"prof-tabs\" ng-if=\"pieceSelected.pieceSizes[pieceIndex].show\">\n          <span ng-show=\"!pieceSizesSelected[pieceIndex]\" ng-bind=\"'prof{0}'.format([pieceIndex + 1])\"></span>\n          <span ng-show=\"pieceSizesSelected[pieceIndex]\" ng-bind=\"layerDisplayName(pieceSizesSelected[pieceIndex])\"></span>\n        </button>\n      </div>\n\n      <div class=\"col-md-12 piece-size-options-panel\" ng-class=\"{'too-many-depths': numberOfPiecesSizes > 5}\">\n        <piece-size-options-panel ng-repeat=\"pieceIndex in piecesIndexAccepted\" current-index=\"{{ pieceIndex }}\" mode=\"edition\"></piece-size-options-panel>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"locked-panel-editing-piece\" ng-class=\"{'visible': showPieceEditionPanel}\"><i class=\"fa fa-lock locked-panel-icon\" aria-hidden=\"true\"></i></div>\n  <div class=\"locked-panel-saving\" ng-class=\"{'visible': carCreationVisible && saveLoadingVisible}\" ng-if=\"saveLoading\"><i class=\"fa fa-cog fa-spin saving-loading-icon\" aria-hidden=\"true\"></i></div>\n</div>\n\n<version-verifier url=\"{{versionUrl}}\" version=\"2.1.0\" notify-outside=\"true\"/>\n"
          },
          "redirectURL": "",
          "headersSize": -1,
          "bodySize": 0,
          "_transferSize": 0,
          "_error": null,
