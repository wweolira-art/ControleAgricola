          "content": {
            "size": 3424,
            "mimeType": "text/html",
            "text": "<div class=\"new-sampling-modal navy-heading-modal use-old-grid-modal pattern-picker\" ng-class=\"{'opened': chinaCarNameModalOpen}\">\n  <form class=\"modal-view\" name=\"useOldGridForm\" novalidate role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"useOldGridModalTitle\">\n    <div class=\"modal-heading\">\n      <div class=\"title-row\">\n        <span class=\"title\" id=\"useOldGridModalTitle\">Usar grade</span>\n        <button type=\"button\" class=\"close-button\" ng-click=\"closeNewChinacarPopup()\" title=\"Fechar\" aria-label=\"Fechar\">\n          <i class=\"fa fa-times\" aria-hidden=\"true\"></i>\n        </button>\n      </div>\n    </div>\n\n    <div class=\"use-old-grid-fields\">\n      <div class=\"pattern-field\">\n        <label class=\"pattern-label\" for=\"chinaCarModel\">Nome da nova grade</label>\n        <input type=\"text\" id=\"chinaCarModel\" class=\"pattern-input\" ng-model=\"newChinaCar.model\">\n      </div>\n\n      <div class=\"pattern-field\">\n        <label class=\"pattern-label\" for=\"chinaCarAnalysisPattern\">Padrão de Preferências de Análise</label>\n        <select id=\"chinaCarAnalysisPattern\" class=\"pattern-input\" ng-model=\"newChinaCar.analysisPreferencePatternId\" ng-disabled=\"currentChinaCar.hasAnalysisPreferencesPatterns\">\n          <option ng-repeat=\"pattern in analysisPreferencesPatterns track by pattern.id\" ng-value=\"pattern.id\">{{pattern.name}}</option>\n        </select>\n      </div>\n\n      <div class=\"selection-section\">\n        <div class=\"selection-section-title\">Qual padrão deseja utilizar?</div>\n      </div>\n    </div>\n\n    <div class=\"pattern-tabs\" role=\"tablist\">\n      <button type=\"button\" class=\"pattern-tab\" role=\"tab\"\n              ng-repeat=\"tab in mergePatternTabs\"\n              id=\"useOldGridPatternTab-{{tab.key}}\"\n              aria-controls=\"useOldGridPatternPanel\"\n              ng-class=\"{'active': mergePatternTab === tab.key}\"\n              aria-selected=\"{{mergePatternTab === tab.key}}\"\n              uib-tooltip=\"{{tab.hint}}\" tooltip-placement=\"bottom\"\n              ng-click=\"selectMergePatternTab(tab.key)\">\n        {{tab.label}}\n      </button>\n    </div>\n\n    <div class=\"modal-body custom-scroll\" id=\"useOldGridPatternPanel\" role=\"tabpanel\" aria-labelledby=\"useOldGridPatternTab-{{mergePatternTab}}\">\n      <div class=\"pattern-feedback\" ng-if=\"patternsLoading\">\n        <i class=\"fa fa-spinner fa-spin\" aria-hidden=\"true\"></i> Carregando padrões...\n      </div>\n\n      <div ng-if=\"!patternsLoading\">\n        <div ng-repeat=\"group in mergePatternGroups\" ng-include=\"'templates/include/pattern-option-list.html'\"></div>\n\n        <div ng-if=\"mergePatternTab === mergePatternTabKeys.SYSTEM\">\n          <div class=\"pattern-list\">\n            <label class=\"pattern-option\" ng-class=\"{'selected': patternSelected.id === systemPattern.id}\">\n              <input type=\"radio\" name=\"patterns\" ng-model=\"patternSelected.id\" ng-value=\"systemPattern.id\">\n              <span>Padrão do Sistema</span>\n            </label>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"modal-footer-actions\">\n      <button type=\"button\" class=\"dismiss-button\" ng-click=\"closeNewChinacarPopup()\">Cancelar</button>\n      <button type=\"button\" class=\"confirm-button\" ng-disabled=\"!newChinaCar.model || !patternSelected.id\" ng-click=\"useChinaCar()\"\n              title=\"{{ !newChinaCar.model ? 'Preencha todos os campos para criar a grade' : '' }}\">Criar Grade</button>\n    </div>\n  </form>\n</div>\n"
          },
