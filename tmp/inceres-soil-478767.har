            "size": 1575,
            "mimeType": "text/html",
            "text": "<div ng-controller=\"searchPieceController\" >\n  <div class=\"search-piece-panel-div\">\n    <form name=\"formSearchPiece\" ng-submit=\"searchPiece(formSearchPiece)\" novalidate>\n      <div class=\"row\">\n        <div class=\"form-group col-md-11\">\n          <label class=\"form-label\">Buscar pontos por: </label>\n          <div class=\"btn-group\">\n            <label class=\"btn btn-default btn-sm\" ng-model=\"searchBy.value\" uib-btn-radio=\"'id'\">Id </label>\n            <label class=\"btn btn-default btn-sm\" ng-model=\"searchBy.value\" uib-btn-radio=\"'longlat'\"> Long - Lat</label>\n          </div>\n        </div>\n\n        <div class=\"form-group col-md-1\">\n          <div> <i class=\"fa fa-times close-icon\" ng-click=\"closeInfo()\" aria-hidden=\"true\"></i> </div>\n        </div>\n      </div>\n      <div class=\"row\">\n        <div class=\"form-group\"  validated>\n          <div class=\"form-group col-md-8\" ng-if=\"searchBy.value === 'id'\">\n            <input type=\"number\" class=\"form-control\" id=\"id\" name=\"id\" ng-model=\"piece.id\" placeholder=\"Id do ponto\">\n          </div>\n          <div class=\"form-group col-md-8\" ng-if=\"searchBy.value === 'longlat'\">\n            <input type=\"text\" class=\"form-control\" id=\"longlat\" name=\"longlat\" ng-model=\"piece.longlat\" placeholder=\"Long - Lat\" setp=\"any\">\n          </div>\n          <div class=\"form-group col-md-4\" validated>\n            <button type=\"submit\" class=\"btn btn-default\">Procurar</button>\n          </div>\n        </div>\n      </div>\n    </form>\n  </div>\n</div>\n<version-verifier url=\"{{versionUrl}}\" version=\"2.1.0\" notify-outside=\"true\"/>\n"
