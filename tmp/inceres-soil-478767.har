          "cookies": [],
          "content": {
            "size": 19928,
            "mimeType": "text/html",
            "text": "<div ng-class=\"{'list-amostragens' : areListAreasVisible, 'list-amostragens-full' : !areListAreasVisible}\" ng-controller=\"SamplesController\">\n  <section ng-style=\"{display: importingUgd ? 'block' : 'none'}\"  ng-include=\"'templates/modal-import-area.html'\"></section>\n\n  <section ng-include=\"'templates/modal_info.html'\"></section>\n\n  <section ng-include=\"'templates/modal-import-car-turing.html'\"></section>\n\n  <div class=\"new-sampling-modal opened\" ng-if=\"newSamplingModalState.isOpen\" ng-include=\"'templates/include/new-sampling-modal.html'\"></div>\n\n  <div class=\"new-sampling-modal navy-heading-modal use-pattern-modal pattern-picker opened\" ng-if=\"usePatternModalState.isOpen\" ng-include=\"'templates/include/use-pattern-modal.html'\"></div>\n\n  <div class=\"sampling-box\" ng-if=\"gridPanelOpen\">\n    <div class=\"sampling-tabs\">\n      <ul class=\"nav nav-tabs\" ng-if=\"!showChinaCars && !showCarsToMerge && !showForeignChassis\">\n        <li class=\"motors-tab\" ng-class=\"{'active': activeTab === samplingTabs.GRIDS}\"><a class=\"tab-name\" href=\"\" ng-click=\"showGridsTab()\">Planejamento Amostral</a></li>\n        <li class=\"motors-tab\" ng-class=\"{'active': activeTab === samplingTabs.ZONES}\"><a class=\"tab-name\" href=\"\" ng-if=\"canICreateUgd\" ng-click=\"showZonesTab()\">Zonas de Manejo</a></li>\n      </ul>\n    </div>\n\n    <div class=\"tab-content content-div\">\n      <div id=\"local\" class=\"tab-pane fade\" ng-class=\"{'active in': activeTab === samplingTabs.GRIDS}\">\n\n        <div class=\"list-filter\" ng-if=\"!showChinaCars && !showCarsToMerge && !showForeignChassis\">\n          <label class=\"list-filter-label\" for=\"statusFilterSelect\">Status:</label>\n          <div class=\"list-filter-field\">\n            <select id=\"statusFilterSelect\" ng-model=\"controllerState.filterPhase\" class=\"list-filter-select\">\n              <option value=\"\">Todas</option>\n              <option ng-repeat=\"phase in statusGroups\" ng-value=\"phase.abbr\">{{phase.abbr}} - {{phase.label}}</option>\n            </select>\n          </div>\n\n          <div class=\"creation-actions\">\n            <button ng-if=\"canICreateAndImportSample\" ng-disabled=\"areasLoading\" class=\"btn-header-action btn-new-sampling\" type=\"button\" ng-click=\"openNewSamplingModal()\" title=\"Nova amostragem\" aria-label=\"Nova amostragem\">\n              <i class=\"fa\" ng-class=\"{'fa-plus': !areasLoading, 'fa-cog fa-spin': areasLoading}\" aria-hidden=\"true\"></i>\n            </button>\n            <button ng-if=\"canICreateAndImportSample\" class=\"btn-header-action\" type=\"button\" ng-click=\"openGridSyncModal()\" title=\"Grades pendentes de associação\" aria-label=\"Grades pendentes de associação\">\n              <svg width=\"14\" height=\"16\" viewBox=\"0 0 16 24\" fill=\"none\" aria-hidden=\"true\">\n                <rect x=\"2\" y=\"1.5\" width=\"12\" height=\"21\" rx=\"2.5\" stroke=\"currentColor\" stroke-width=\"1.8\"></rect>\n                <line x1=\"6.5\" y1=\"19\" x2=\"9.5\" y2=\"19\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"></line>\n              </svg>\n            </button>\n          </div>\n        </div>\n\n        <div class=\"row china-cars-options\" ng-if=\"showChinaCars\">\n          <div class=\"col-sm-12 col-md-12\">\n            <h4>Usar Antigas</h4>\n            <button type=\"button\" class=\"close-icon\" title=\"Fechar\" aria-label=\"Fechar\" ng-click=\"dontUseChinaCar()\">&times;</button>\n          </div>\n        </div>\n\n        <div class=\"row china-cars-options\" ng-if=\"showCarsToMerge\">\n          <div class=\"col-sm-12 col-md-12\">\n            <button type=\"button\" class=\"btn btn-default merge-button\" ng-click=\"useAnalysisPreferencesPattern()\">Unir Amostragens<span ng-if=\"selectedCarsToMergeCount()\"> ({{selectedCarsToMergeCount()}})</span></button>\n            <button type=\"button\" class=\"close-icon\" title=\"Fechar\" aria-label=\"Fechar\" ng-click=\"stopMergingCars()\">&times;</button>\n          </div>\n        </div>\n\n        <div class=\"list-filter grid-category-filter\" ng-if=\"showChinaCars || showCarsToMerge\">\n          <label class=\"list-filter-label\" for=\"gridCategoryFilterSelect\">Tipo:</label>\n          <div class=\"list-filter-field\">\n            <select id=\"gridCategoryFilterSelect\" ng-model=\"controllerState.filterGridCategory\" class=\"list-filter-select\">\n              <option value=\"\">Todos</option>\n              <option ng-repeat=\"category in gridCategories.FILTERABLE\" ng-value=\"category\">{{category}}</option>\n            </select>\n          </div>\n        </div>\n\n        <div class=\"cars-to-merge custom-scroll\" ng-if=\"showCarsToMerge\">\n          <list-empty-notice ng-if=\"shouldShowEmptyCategoryNotice()\" message=\"{{gridCategories.EMPTY_FILTER_MESSAGE}}\"></list-empty-notice>\n          <div class=\"row car\"  ng-repeat=\"car in carsToMerge | filter:gridCategoryMatcher\">\n            <div class=\"col-md-1 union-samples\" ng-click=\"toggleSelectCarToMerge(car)\">\n                <input type=\"checkbox\" ng-model=\"car.selected\"/><label></label>\n            </div>\n            <div class=\"col-md-6 car-name-column\" ng-click=\"selectCarToExpose(car)\">\n              <span>{{car.model | limitWithEllipsis:15}}</span>\n              <car-category-label car=\"car\"></car-category-label>\n            </div>\n            <div class=\"col-md-2\" >\n              <div ng-if=\"car.analysisPreferencePatternId\">\n                <span title=\"{{car.analysisPreferencesPatternName}}\">{{ car.analysisPreferencePatternId }}</span>\n              </div>\n              <div ng-if=\"!car.analysisPreferencePatternId\">\n                <i class=\"fa fa-exclamation-triangle\" title=\"Essa grade não tem um padrão de análise vinculado.\"></i>\n              </div>\n            </div>\n            <div class=\"col-md-2 see-car-column\" ng-click=\"selectCarToExpose(car)\">\n              <div ng-if=\"car.showingPoints\">\n                <i class=\"fa fa-eye-slash see-car-to-expose see-car-to-expose-selected\"></i>\n              </div>\n              <div ng-if=\"!car.showingPoints\">\n                <i class=\"fa fa-eye see-car-to-expose\"></i>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div ng-if=\"!showCarsToMerge && !showForeignChassis\" class=\"custom-scroll\" ng-class=\"{'samples-container': areListAreasVisible, 'samples-container-full': !areListAreasVisible, 'is-china-cars': showChinaCars}\">\n          <div class=\"row\" ng-if=\"showChinaCars\">\n            <div class=\"col-sm-12 col-md-12\">\n              <input type=\"text\" class=\"sampling-search-input\" ng-model=\"searchText\" ng-change=\"filterChinaCars(searchText)\" placeholder=\"Digite para filtrar\" class=\"form-control\"/>\n            </div>\n          </div>\n          <list-empty-notice ng-if=\"chinaCars.length < 1 && showChinaCars\" message=\"Você não possui amostragens antigas para serem utilizadas.\"></list-empty-notice>\n          <list-empty-notice ng-if=\"shouldShowEmptyCategoryNotice()\" message=\"{{gridCategories.EMPTY_FILTER_MESSAGE}}\"></list-empty-notice>\n          <div class=\"row list-car-item china-cars\"  ng-class=\"{'car-selected': car.selected, 'big': car.selected}\" ng-if=\"showChinaCars\"  ng-repeat=\"car in filteredChinaCars | filter:gridCategoryMatcher\">\n            <div class=\"col-sm-10 col-md-10 car-item-custom\" ng-click=\"selectChinaCar(car)\">\n              <span ng-bind=\"::chinaCarsInfos(car)\"></span>\n              <car-category-label car=\"::car\"></car-category-label>\n              <div class=\"china-car-stats\" ng-if=\"currentChinaCar && car.selected\">\n                <span ng-bind=\"::currentChinaCarStats()\"></span>\n              </div>\n            </div>\n            <div class=\"col-sm-2 col-md-2\" >\n              <div class=\"btn-group dots-menu-group\">\n                <button type=\"button\" class=\"btn btn-default dropdown-toggle dots-menu\" data-toggle=\"dropdown\" aria-haspopup=\"true\" aria-expanded=\"false\">\n                  <i class=\"fa fa-ellipsis-h\" aria-hidden=\"true\"></i>\n                </button>\n                <ul class=\"dropdown-menu car-edit-dropmenu\">\n                  <li ng-click=\"cloneCar(car)\"><a href=\"#\"><i class=\"fa fa-clone\" aria-hidden=\"true\"></i> Somente Grade</a></li>\n                  <li ng-click=\"useChinaCarWithNewName(car)\" ng-if=\"car.piecesInstalled\"><a href=\"#\"><i class=\"fa fa-clone\" aria-hidden=\"true\"></i> Grade com Dados</a></li>\n                </ul>\n              </div>\n            </div>\n          </div>\n\n          <div ng-if=\"!showChinaCars && !showCarsToMerge\" id=\"{{::car.id}}\" class=\"list-car-item\" ng-class=\"{'car-selected': car.selected, 'is-loading': car.loading}\" ng-click=\"openCar(car, $event)\" ng-keydown=\"openCarFromKeyboard(car, $event)\" role=\"button\" tabindex=\"0\" ng-repeat=\"car in cars | filter:phaseMatcher\">\n            <div class=\"card-loading-overlay\" ng-if=\"car.loading\">\n              <i class=\"fa fa-spinner fa-spin\" aria-hidden=\"true\"></i>\n              <span>Por favor, aguarde...</span>\n            </div>\n            <div class=\"btn-group dots-menu-group\">\n              <button type=\"button\" class=\"btn btn-default dropdown-toggle dots-menu\" data-toggle=\"dropdown\" aria-haspopup=\"true\" aria-expanded=\"false\">\n                <i class=\"fa fa-ellipsis-h\"  aria-hidden=\"true\"></i>\n              </button>\n              <ul class=\"dropdown-menu car-edit-dropmenu\">\n                <li ng-click=\"editCarName(car)\"><a href=\"#\"><i class=\"fa fa-pencil\" aria-hidden=\"true\"></i> Editar nome</a></li>\n                <li ng-click=\"editCar(car)\" ng-if = \"!car.piecesInstalled\"><a href=\"#\"><i class=\"fa fa-pencil\" aria-hidden=\"true\"></i> Editar grade</a></li>\n                <li role=\"separator\" class=\"divider\"></li>\n                <li ng-if=\"canIDownloadResultsWithLatLong && canDownloadResultsOf(car)\" ng-click=\"downloadWithLatLong(car)\" ><a href=\"#\"><i class=\"fa fa fa-file-excel-o\" aria-hidden=\"true\"></i> Baixar resultados com lat long</a></li>\n                <li ng-if=\"canISendGridToApi\" ng-click=\"uploadCarToAnAPI(car)\" ><a href=\"#\"><i class=\"fa fa fa-upload\" aria-hidden=\"true\"></i> Enviar grade para API</a></li>\n                <li ng-if=\"hasInsulfilm(car)\" ng-click=\"prepareToInsulfilmMyCar(car)\"><a ><i class=\"fa fa-pencil\" aria-hidden=\"true\"></i> Visualizar camada de apoio</a></li>\n                <li ng-click=\"printLabels(car, $event)\" ng-class=\"{'disabled': carsBeingDownloaded[car.id]}\">\n                  <a href=\"#\">\n                    <i class=\"fa\" ng-class=\"{'fa-barcode': !carsBeingDownloaded[car.id], 'disabled fa-hourglass-half': carsBeingDownloaded[car.id]}\"\n                       aria-hidden=\"true\"></i> Imprimir Etiquetas\n                  </a>\n                </li>\n                <li ng-if=\"car.canIAddSubPieces\" ng-click=\"cloneCarForAddSub(car.id, car)\"><a href=\"#\"><i class=\"fa fa-bullseye\" aria-hidden=\"true\"></i> Adicionar subamostras</a></li>\n                <li ng-if=\"car.canICloneCar\" ng-click=\"cloneCar(car)\"><a href=\"#\"><i class=\"fa fa-clone\" aria-hidden=\"true\"></i> Criar a partir desta</a></li>\n                <li role=\"separator\" class=\"divider\"></li>\n                <li ng-if=\"car.canICloneCar\" ng-click=\"basedCar(car.id, 'random', car)\">\n                  <a href=\"#\"><i class=\"fa fa-dot-circle-o\" aria-hidden=\"true\">\n                  </i> Completar essa com otimizada\n                  </a>\n                </li>\n                <li ng-if=\"car.madeIn != 'ugd'\" ng-click=\"basedCar(car.id, 'mesh', car)\">\n                  <a href=\"#\">\n                    <i class=\"fa fa-dot-circle-o\" aria-hidden=\"true\"></i>\n                    Completar essa com quadrática\n                  </a>\n                </li>\n                <li role=\"separator\" class=\"divider\" ng-if=\"canIDeleteSample\"></li>\n                <li ng-if=\"canIDeleteSample && canClearResultsOf(car)\" ng-click=\"clearCarResults(car)\"><a href=\"#\"><i class=\"fa fa-eraser\" aria-hidden=\"true\"></i> Limpar os dados da grade</a></li>\n                <li ng-if=\"canIDeleteSample\" ng-click=\"deleteCar(car)\"><a href=\"#\"><i class=\"fa fa-trash\" aria-hidden=\"true\"></i> Excluir</a></li>\n              </ul>\n            </div>\n\n            <ul class=\"sampling-list\">\n              <li class=\"car-id-row\" ng-if=\"!car.editName\">\n                <span class=\"car-id\">{{ car.id }}</span>\n              </li>\n              <li class=\"sampling-name-width car-name-row\">\n                <span ng-if=\"!car.editName\" class=\"car-name\" title=\"{{car.model}}\" ng-bind=\"car.model | limitWithEllipsis:28\"></span>\n                <span ng-if=\"!car.editName\" class=\"car-date\">{{car.dateOfManufacture | date:'dd/MM/yy'}}</span>\n\n                <input ng-if=\"car.editName\" ng-blur=\"saveCarName(car)\" autofocus type=\"text\" name=\"carName\" class=\"form-control car-name-form\" ng-model=\"car.model\" ng-click=\"$event.stopPropagation()\" ng-keydown=\"$event.keyCode === 13 && saveCarName(car)\" />\n              </li>\n              <li class=\"car-tags-row\" ng-if=\"!car.editName\">\n                <span class=\"sample-pill\">{{car.samplingType | samplingTypeLabel}}</span>\n                <car-category-label car=\"car\"></car-category-label>\n              </li>\n              <li class=\"car-status-row\">\n                <span class=\"status-tone\" ng-class=\"car.status | statusPhaseTone\" aria-hidden=\"true\"></span>\n                <span class=\"car-status\">{{car.status | statusPhase}}</span>\n              </li>\n            </ul>\n          </div>\n        </div>\n\n        <progress loading=\"loading\" class=\"spinner loading-amostragens\"></progress>\n      </div>\n\n      <div ng-if=\"!showChinaCars\" id=\"v2\" class=\"tab-pane fade listagem-v2 custom-scroll\">\n        <div class=\"list-car-item\" ng-repeat=\"item in itens | orderBy: '-thedate'\">\n        <span class=\"sampling-list\" ng-click=\"rentACar(item.id, item.name, item.type)\">\n          <li class=\"sampling-name-width\"> {{item.name}}</li>\n            <small>\n              <li>Id: {{item.id}} -  Data:{{item.theDate | date:'dd/MM/yyyy'}} | {{item.type}}</li>\n            </small>\n        </span>\n        </div>\n      </div>\n\n      <div ng-if=\"!showChinaCars && !showCarsToMerge\" id=\"ugd\" class=\"tab-pane fade listagem-ugds\" ng-class=\"{'active in': activeTab === samplingTabs.ZONES}\">\n        <div class=\"header header-ugds\" ng-if=\"!showForeignChassis\">\n          <button class=\"zone-action-button\" ng-if=\"canICreateUgd\" ng-click=\"askSmToOpenAgrimensor()\">\n            <i class=\"fa fa-plus\" aria-hidden=\"true\"></i>\n            <span>Criar zona de manejo</span>\n          </button>\n          <button class=\"zone-action-button\" ng-if=\"canIImportUgd\" ng-click=\"openImportUgdModal()\">\n            <i class=\"fa fa-upload\" aria-hidden=\"true\"></i>\n            <span>Importar zona de manejo</span>\n          </button>\n          <button class=\"zone-action-button\" ng-class=\"{'active': showForeignChassis}\" ng-click=\"seeForeignChassis()\">\n            <i class=\"fa fa-clone\" aria-hidden=\"true\"></i>\n            <span>Usar outras</span>\n          </button>\n        </div>\n        <div class=\"header header-old-ugds\" ng-if=\"showForeignChassis\">\n          <div class=\"row foreign-chassis-options\" ng-if=\"showForeignChassis\">\n            <div class=\"col-sm-10 col-md-10 title\">\n              <label>Zonas de Manejo e Hexagonais de outros ciclos</label>\n            </div>\n            <div class=\"col-sm-2 col-md-2\">\n              <button type=\"button\" class=\"close-old-cars\" title=\"Fechar\" aria-label=\"Fechar\" ng-click=\"closeForeignChassis()\">&times;</button>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"ugd-list-body custom-scroll\" ng-if=\"!showForeignChassis\">\n          <div class=\"list-car-item\" ng-repeat=\"chassis in chassisList | orderBy: '-createdAt'\" ng-class=\"{'car-selected': chassis.selected}\" ng-click=\"openChassis(chassis, $event)\" ng-keydown=\"openChassisFromKeyboard(chassis, $event)\" role=\"button\" tabindex=\"0\">\n            <span class=\"sampling-list\">\n              <li class=\"sampling-name-width\"> {{chassis.id}}\n                <small>\n                   <div class=\"btn-group dots-menu-group\">\n                      <button type=\"button\" class=\"btn btn-default dropdown-toggle dots-menu\" data-toggle=\"dropdown\" aria-haspopup=\"true\" aria-expanded=\"false\">\n                        <i class=\"fa fa-ellipsis-h\"  aria-hidden=\"true\"></i>\n                      </button>\n                      <ul class=\"dropdown-menu car-edit-dropmenu\">\n                        <li ng-click=\"editUgdName(chassis)\"><a href=\"#\"><i class=\"fa fa-pencil\" aria-hidden=\"true\"></i> Editar nome</a></li>\n                        <li ng-click=\"openUgdEditor(chassis.id, chassis.isHexagonal)\"><a href=\"#\"><i class=\"fa fa-object-group\" aria-hidden=\"true\"></i> Editar {{chassis.isHexagonal | zoneKindLabel | lowercase}}</a></li>\n                        <li role=\"separator\" class=\"divider\"></li>\n                        <li ng-click=\"openZoneSamplingModal(chassis.id)\"><a href=\"#\"><i class=\"fa fa-plus\" aria-hidden=\"true\"></i> Nova amostragem</a></li>\n                        <li ng-click=\"downloadUGD(chassis.id)\"><a href=\"#\"><i class=\"fa fa-cloud-download\" aria-hidden=\"true\"></i> Download das {{chassis.isHexagonal | zoneKindPluralLabel | lowercase}}</a></li>\n                        <li ng-if=\"!chassis.isHexagonal\" ng-click=\"prepareToShowChassisLayers(chassis)\"><a href=\"#\"><i class=\"fa fa-cloud-download\" aria-hidden=\"true\"></i> Visualizar camadas utilizadas nas zonas de manejo</a></li>\n                        <li role=\"separator\" class=\"divider\"></li>\n                        <li ng-click=\"deleteChassis(chassis)\"><a href=\"#\"><i class=\"fa fa-trash\" aria-hidden=\"true\"></i> Excluir</a></li>\n                      </ul>\n                   </div>\n                </small>\n              </li>\n              <li>\n                <small>\n                  <span ng-if=\"!chassis.editName\"> {{chassis.name}}</span>\n                   <input ng-if=\"chassis.editName\" ng-blur=\"saveChassisName(chassis)\" autofocus type=\"text\" name=\"chassis\" class=\"form-control car-name-form\" ng-model=\"chassis.name\"\n                          ng-click=\"$event.stopPropagation()\" ng-keydown=\"$event.keyCode === 13 && saveChassisName(chassis)\">\n                  <span class=\"pull-right\"> {{chassis.createdAt | date:'dd/MM/yyyy'}}</span>\n                </small>\n              </li>\n              <li class=\"status-row\">\n                <span class=\"sample-pill\">{{chassis.isHexagonal | zoneKindLabel}}</span>\n              </li>\n            </span>\n          </div>\n        </div>\n        <div class=\"foreign-chassis-list custom-scroll\" ng-if=\"showForeignChassis\">\n          <div class=\"chassis-item\" ng-class=\"{'selected': chassis.id === currentForeignChassis.id}\" ng-repeat=\"chassis in oldChassisList | orderBy: '-createdAt'\">\n            <span class=\"chassis-inner-item\">\n              <ul>\n                <li class=\"actions-box\"  ng-click=\"getForeignChassis(chassis.id)\"> {{chassis.id}}\n                  <button ng-click=\"copyForeignChassisToCycle(chassis)\" type=\"button\" class=\"btn btn-default button-use\"> Usar</button>\n                </li>\n                <li>\n                  <small>\n                    <span  ng-click=\"getForeignChassis(chassis.id)\" class=\"chassis-name\"> {{chassis.name}}</span>\n                    <span  ng-click=\"getForeignChassis(chassis.id)\" class=\"pull-right\"> {{chassis.createdAt | date:'dd/MM/yyyy'}}</span>\n                  </small>\n                </li>\n              </ul>\n            </span>\n          </div>\n        </div>\n        <progress loading=\"foreignChassisloading\" class=\"spinner loading-amostragens\"></progress>\n      </div>\n    </div>\n  </div>\n\n  <section ng-include=\"'templates/depths-panel.html'\"></section>\n  <section ng-include=\"'templates/unity-popup.html'\"></section>\n  <section ng-include=\"'templates/include/list-tools.html'\"></section>\n  <section ng-include=\"'templates/include/china-car-name-popup.html'\"></section>\n  <section ng-include=\"'templates/include/choose-analysis-preferences-pattern-popup.html'\"></section>\n  <section ng-include=\"'templates/include/choose-fertilities-pattern-popup.html'\"></section>\n</div>\n\n<version-verifier url=\"{{versionUrl}}\" version=\"2.1.0\" notify-outside=\"true\"/>\n"
          },
