          "content": {
            "size": 1197,
            "mimeType": "text/html",
            "text": "<div ng-controller=\"UnityController\" class=\"popup-unitys\" ng-class=\"{'opened': showUnityPopUp}\">\n    <div class=\"panel panel-default panel-unity-view\">\n        <div class=\"panel-body-unity\">\n            <div class=\"row\">\n                    <div ng-repeat=\"(atributo, element) in elements\">\n                        <div class=\"form-group col-md-2\">\n                            <div class=\"input-group\" >\n                            <label class=\"input-group-addon\">{{atributo}} </label>\n                            <select ng-model=\"element.unity\" class=\"form-control\" >\n                                <option ng-repeat=\"unity in element.unitys\">{{unity}}</option>\n                            </select>\n                            </div>\n                        </div>\n                    </div>\n            </div>\n        </div>\n        <div class=\"panel-footer\">\n            <button type=\"button\" class=\"btn btn-success\" ng-click=\"changeMySpecification(elements)\">Salvar</button>\n            <button type=\"button\" class=\"btn btn-danger\" ng-click=\"closeUnityPopUp()\">Fechar</button>\n        </div>\n    </div>\n</div>\n<version-verifier url=\"{{versionUrl}}\" version=\"2.1.0\" notify-outside=\"true\"/>\n"
          },
          "redirectURL": "",
