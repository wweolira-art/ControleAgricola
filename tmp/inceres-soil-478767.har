            "text": "<div ng-controller=\"ImportUgdController\" class=\"popup-import-ugd\">\n  <form name=\"importFormUgd\" novalidate ng-submit=\"submitForm(importFormUgd)\">\n    <div class=\"panel panel-default popup-view\">\n      <div class=\"panel-heading\">\n        Importar zona de manejo\n        <button type=\"button\" class=\"close-modal-button\" title=\"Fechar\" aria-label=\"Fechar\" ng-click=\"closeModalImportUgd()\">&times;</button>\n      </div>\n      <div class=\"panel-body\">\n        <progress loading=\"loading\" class=\"loading-importing-spinner loading-amostragens\"></progress>\n        <div ng-show=\"!loading\">\n          <p class=\"import-ugd-intro\">Certifique-se de que o arquivo importado corresponde exatamente à área em que você está trabalhando no sistema.</p>\n\n          <div class=\"form-group\" validated>\n            <label class=\"control-label\">Nome da zona</label>\n            <input type=\"text\" class=\"form-control\" id=\"model\" name=\"name\" ng-model=\"ugdInfos.name\" required>\n            <span ng-if=\"importFormUgd.name.$error.required\" class=\"fa fa-exclamation-circle element-with-exclamation\"></span>\n          </div>\n\n          <div class=\"form-group\">\n            <label for=\"file\" class=\"ugd-dropzone\" ngf-drop ng-model=\"ugdInfos.file\"\n                   ngf-max-size=\"100MB\" ngf-model-invalid=\"errorFile\" ngf-pattern=\"'.zip,.Zip,.ZIP'\">\n              <i class=\"fa fa-cloud-upload\" aria-hidden=\"true\"></i>\n              <span class=\"ugd-dropzone-title\">Arraste o arquivo aqui ou clique para buscar</span>\n              <span class=\"ugd-dropzone-hint\">Formatos aceitos: .zip</span>\n              <input type=\"file\" id=\"file\" class=\"ugd-file-input\" ngf-select ng-model=\"ugdInfos.file\" name=\"fileUpload\" required\n                     accept=\"application/zip\" ngf-max-size=\"100MB\"\n                     ngf-model-invalid=\"errorFile\" ngf-pattern=\"'.zip,.Zip,.ZIP'\">\n            </label>\n            <table class=\"table ugd-file-info\" ng-if=\"ugdInfos.file\">\n              <thead>\n              <tr>\n                <th width=\"75%\">Nome</th>\n                <th>Tamanho</th>\n              </tr>\n              </thead>\n              <tbody>\n              <tr>\n                <td><strong>{{ ugdInfos.file.name }}</strong></td>\n                <td ng-show=\"ugdInfos.file.size > 0\">\n                  <strong ng-bind=\"ugdInfos.file.size|formatFileSize\"></strong>\n                </td>\n              </tr>\n              </tbody>\n            </table>\n            <div class=\"info-arquivo\">\n              <i ng-show=\"importFormUgd.fileUpload.$error.maxSize\">\n                O arquivo com <strong ng-bind=\"errorFile.size|formatFileSize\"></strong> ultrapassa o tamanho máximo permitido de <b>100MB</b>, selecione outro arquivo.</i>\n              <i ng-show=\"importFormUgd.fileUpload.$error.minSize\">O tamanho mínimo para upload é de <b>1KB</b>, selecione outro arquivo.</i>\n              <i ng-show=\"importFormUgd.fileUpload.$error.pattern\">Somente arquivos <b>.zip</b> podem ser enviados, selecione outro arquivo.</i>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div ng-show=\"!loading\">\n        <div class=\"panel-footer\">\n          <button type=\"button\" class=\"btn sheet-close\" ng-click=\"closeModalImportUgd()\">Cancelar</button>\n          <button type=\"submit\" class=\"btn btn-primary sheet-send\">Importar</button>\n        </div>\n      </div>\n    </div>\n  </form>\n</div>\n\n<version-verifier url=\"{{versionUrl}}\" version=\"2.1.0\" notify-outside=\"true\"/>\n"
          },
