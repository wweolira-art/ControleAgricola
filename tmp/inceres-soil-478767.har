          "cookies": [],
          "content": {
            "size": 5280,
            "mimeType": "text/html",
            "text": "<div ng-controller=\"ImportSheetController\" class=\"popup-import-sheet\">\n  <form name=\"importFormSheet\" novalidate ng-submit=\"submitForm(importFormSheet)\">\n    <div class=\"panel panel-default popup-sheet-view\">\n      <div class=\"panel-sheet-heading\">\n        {{importSheetStepName}}\n        <button type=\"button\" class=\"close-icon\" ng-show=\"!loading\" ng-click=\"closeSheetModal()\" aria-label=\"Fechar importação de planilhas\"><i class=\"fa fa-times\" aria-hidden=\"true\"></i></button>\n      </div>\n      <div class=\"panel-sheet-body scroll-tool custom-scroll\">\n        <progress loading=\"loading\" class=\"loading-importing-spinner\"></progress>\n\n        <div class=\"container-fluid\" ng-show=\"importSheetStep === 1 && !loading\">\n          <div class=\"row warning-sheet\">\n            <h2>Atenção!</h2>\n            <p>Apenas planilhas no modelo padrão da InCeres podem ser importadas.\n              <a class=\"ugd-download\" href=\"\" ng-click=\"downloadSheet()\">Clique aqui para Baixar Planilha Modelo</a>\n            </p>\n          </div>\n          <div class=\"row file-chooser-row\">\n            <label class=\"file-picker\" for=\"carZip\">\n              <span class=\"file-picker-button\">Escolher arquivo</span>\n              <span class=\"file-picker-name\" ng-class=\"{'is-empty': !carZip}\" ng-bind=\"carZip.name || 'Nenhum arquivo escolhido'\"></span>\n            </label>\n            <input type=\"file\" class=\"hidden\" id=\"carZip\" name=\"carZip\" ngf-select ng-model=\"carZip\"\n                   accept=\"*/*\" ngf-model-invalid=\"errorFile\" required>\n          </div>\n          <div class=\"row has-values-inform\" ng-if=\"state.piecesInstalled\">\n            <div class=\"sheet-data-warning\" role=\"alert\">Esta amostragem já possui dados. Estes poderão ser sobrescritos pelos dados desta planilha.</div>\n          </div>\n        </div>\n\n        <div class=\"container-fluid leaf-import-infos\" ng-show=\"importSheetStep === 2 && isLeafCar && !loading\">\n          <div class=\"row\">\n            <div class=\"form-group col-md-6\">\n              <label for=\"leafTitle\">Título da análise:</label>\n              <input type=\"text\" id=\"leafTitle\" class=\"form-control\" ng-model=\"leafInfos.title\" required/>\n            </div>\n            <div class=\"form-group col-md-6\">\n              <label for=\"leafDate\">Data da análise:</label>\n              <input type=\"date\" id=\"leafDate\" class=\"form-control\" ng-model=\"leafInfos.date\" required/>\n            </div>\n          </div>\n          <div class=\"row\">\n            <div class=\"form-group col-md-12\">\n              <label for=\"leafPattern\">Padrão de Legenda (opcional):</label>\n              <select id=\"leafPattern\" class=\"form-control\" ng-model=\"leafInfos.patternId\"\n                      ng-options=\"pattern.id as pattern.name for pattern in leafPatternOptions\">\n                <option value=\"\">Padrão do sistema</option>\n              </select>\n            </div>\n          </div>\n          <div class=\"row\">\n            <div class=\"alert alert-info\" role=\"alert\">\n              Reimportar com o mesmo título e data substitui os mapas foliares desta análise; título ou data diferentes criam uma nova análise na aba Foliar.\n            </div>\n          </div>\n        </div>\n\n        <div class=\"container-fluid pattern-picker\" ng-show=\"importSheetStep === 2 && !isLeafCar && !loading\">\n          <div class=\"pattern-tabs\" role=\"tablist\">\n            <button type=\"button\" class=\"pattern-tab\" role=\"tab\"\n                    ng-repeat=\"tab in patternTabs\"\n                    ng-class=\"{'active': patternTab === tab.key}\"\n                    aria-selected=\"{{patternTab === tab.key}}\"\n                    uib-tooltip=\"{{tab.hint}}\" tooltip-placement=\"bottom\" tooltip-append-to-body=\"true\"\n                    ng-click=\"selectPatternTab(tab.key)\">\n              {{tab.label}}\n            </button>\n          </div>\n\n          <div class=\"pattern-picker-body\">\n            <div ng-repeat=\"group in patternGroups\" ng-include=\"'templates/include/pattern-option-list.html'\"></div>\n\n            <div ng-if=\"patternTab === patternTabKeys.SYSTEM\">\n              <div class=\"pattern-list\">\n                <label class=\"pattern-option\" ng-class=\"{'selected': patternSelected.id === systemPattern.id}\">\n                  <input type=\"radio\" name=\"patterns\" ng-model=\"patternSelected.id\" ng-value=\"systemPattern.id\">\n                  <span>Padrão do Sistema</span>\n                </label>\n              </div>\n            </div>\n          </div>\n        </div>\n\n      </div>\n\n      <div class=\"panel-footer\" ng-show=\"!loading\">\n        <button type=\"button\" class=\"btn btn-danger action-buttons\" ng-if=\"importSheetStep === 1\" ng-click=\"closeSheetModal()\">Cancelar</button>\n        <button type=\"button\" class=\"btn back-button action-buttons\" ng-if=\"importSheetStep === 2\" ng-click=\"backStepImportSheet()\">Voltar</button>\n\n        <button type=\"button\" class=\"btn btn-success action-buttons\" ng-disabled=\"!carZip\" ng-if=\"importSheetStep === 1\" ng-click=\"nextStepImportSheet()\">Avançar</button>\n        <button type=\"submit\" class=\"btn btn-success action-buttons\" ng-disabled=\"!canImportSheet()\" ng-if=\"importSheetStep === 2\">Importar</button>\n      </div>\n    </div>\n  </form>\n</div>\n\n<version-verifier url=\"{{versionUrl}}\" version=\"2.1.0\" notify-outside=\"true\"/>\n"
          },
