          "content": {
            "size": 1884,
            "mimeType": "text/html",
            "text": "<div ng-controller=\"ChassisResumeTable\">\n  <div class=\"ugd-resume-table\" ng-if=\"showResumeTable\" ng-class=\"{'visible': showResumeTable}\">\n    <div class=\"ugd-resume-header\">\n      Tabela de Referência de Zonas\n      <i class=\"fa fa-refresh urh-icon urh-edit-icon\" ng-click=\"recalculateCar()\" aria-hidden=\"true\"></i>\n    </div>\n\n    <div class=\"ugd-resume-body custom-scroll\">\n      <div class=\"ugd-resume-infos\" ng-repeat=\"zone in zonesResume\">\n        <div class=\"row\">\n          <div class=\"col-md-4\">\n            <span>ID: {{zone.displayId}}</span>\n          </div>\n          <div class=\"col-md-8\" >\n            <span>Nome: {{zone.name}}</span>\n          </div>\n        </div>\n        <div class=\"row\">\n          <div class=\"col-md-8\" >\n            <span>Quantidade de Pontos: {{zone.pointsQuantity}}</span>\n          </div>\n          <div class=\"col-md-4\">\n          </div>\n        </div>\n\n        <div class=\"row\">\n          <div class=\"col-md-4\">\n            Densidade:\n          </div>\n          <div class=\"col-md-8\">\n            <input type=\"number\" class=\"form-control\" id=\"density\" ng-model=\"zone.density\" ng-keypress=\"handleInputKeyDown($event, zone)\" ng-change=\"startCarRecalculationCountdown(zone)\">\n          </div>\n        </div>\n\n        <div class=\"row\">\n          <div class=\"col-md-8\">\n            <span>Hectares: {{zone.hectares}}</span>\n          </div>\n        </div>\n        <div class=\"row\">\n          <div class=\"col-md-4\">\n            Distância da Borda:\n          </div>\n          <div class=\"col-md-8\">\n            <input type=\"number\" class=\"form-control\" id=\"border_buffer\" ng-model=\"zone.borderBuffer\" ng-keypress=\"handleInputKeyDown($event, zone)\" ng-change=\"startCarRecalculationCountdown(zone)\">\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n<version-verifier url=\"{{versionUrl}}\" version=\"2.1.0\" notify-outside=\"true\"/>\n"
          },
