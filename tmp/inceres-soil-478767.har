            "text": "<div ng-controller=\"RequestedController\" class=\"popup-view-sampling\" ng-class=\"{'opened': popupInfosOpened}\">\n    <div class=\"panel panel-default popup-view\">\n        <div class=\"panel-heading\">\n            Lista de Elementos Solicitados\n        </div>\n        <div class=\"panel-body\">\n            <table class=\"table table-bordered\">\n                <thead>\n                <tr>\n                    <th>\n                        <a>\n                            Ponto\n                        </a>\n                    </th>\n                    <th>\n                        <a>\n                        Atributos Solicitados\n                        </a>\n                    </th>\n                    <th>\n                        <a>\n                            Profundidade\n                        </a>\n                    </th>\n                </tr>\n                </thead>\n                <tbody>\n                <tr ng-repeat=\"piece in piecesToRepeat\">\n\n                    <td>{{piece.id}}</td>\n                    <td>{{piece.requireds}}</td>\n                    <td>{{piece.prof}}</td>\n                </tr>\n                </tbody>\n            </table>\n        </div>\n        <div class=\"panel-footer\">\n            <button type=\"button\" class=\"btn btn-danger\" ng-click=\"closeModalInfo()\">Fechar</button>\n        </div>\n    </div>\n</div>\n<version-verifier url=\"{{versionUrl}}\" version=\"2.1.0\" notify-outside=\"true\"/>\n"
