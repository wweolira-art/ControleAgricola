          "content": {
            "size": 2099,
            "mimeType": "text/html",
            "text": "<div class=\"list-areas\" ng-controller=\"ListAreasController\">\n  <div class=\"container-fluid\">\n    <div class=\"row\">\n      <div class=\"col-md-10\">\n        <div class=\"search-input\">\n          <input  class=\"form-control search-input-element\" ng-model=\"filtrarAreas\" placeholder=\"Buscar Areas\"/>\n        </div>\n      </div>\n      <div class=\"col-md-2\">\n        <div class=\"row list-areas-arrow\" ng-class=\"{'list-areas-expanded-arrow': areListAreasExpanded}\">\n          <i class=\"fa fa-angle-down list-areas-arrow-icon\" ng-click=\"expandListAreas()\" ng-if=\"!areListAreasExpanded\"></i>\n          <i class=\"fa fa-angle-up list-areas-arrow-icon\" ng-click=\"retractListAreas()\" ng-if=\"areListAreasExpanded\"></i>\n        </div>\n      </div>\n    </div>\n    <div class=\"row\">\n      <div class=\"col-md-12\">\n        <div class=\"number-of-selected-areas\">Areas Selecionadas: {{selectedAreasCounter}} de {{totalAreas}}</div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"table-of-areas custom-scroll\" ng-if=\"areListAreasExpanded\">\n    <table class=\"table table-condensed table-striped\">\n      <thead class=\"areas-table-head\">\n        <tr>\n          <th ng-click=\"selectAll()\">\n            <input type=\"checkbox\" ng-model=\"allSelected\"/><label></label>\n          </th>\n          <th>Quadra</th>\n          <th>Talhão</th>\n        </tr>\n      </thead>\n      <tbody class=\"areas-table-body\">\n        <tr class=\"area-div\" ng-class=\"{'area-selected': area.selected}\" ng-repeat=\"area in areas | filter : {name: filtrarAreas}\" ng-click=\"toggleSelectedArea(area)\">\n          <td class=\"checkbox-td\">\n            <input type=\"checkbox\" ng-model=\"area.selected\" ng-click=\"$event.stopPropagation()\"/><label></label>\n          </td>\n          <td title=\"{{area.block}}\" class=\"area-name\" ng-bind=\"area.block | limitWithEllipsis:22\"></td>\n          <td title=\"{{area.field}}\" class=\"area-name\">{{area.field}}</td>\n          <td class=\"area-name\">{{area.totalArea.formataDecimal()}} ha</td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n</div>\n<version-verifier url=\"{{versionUrl}}\" version=\"2.1.0\" notify-outside=\"true\"/>\n"
          },
