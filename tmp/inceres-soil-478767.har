          "content": {
            "size": 3880,
            "mimeType": "text/html",
            "text": "<div class=\"infinity-panel\" ng-controller=\"ListPiecesValueController\">\n  <div class=\"list-pieces-value-panel-div\" ng-class=\"{'in-edit-mode': inEditMode}\">\n    <div class=\"list-pieces-heading\">\n      <h5>Ponto {{ selectedPiece.displayId }}<span ng-if=\"(selectedPiece | describeSubPieces)\"> - {{ selectedPiece | describeSubPieces }}</span></h5>\n      <button class=\"btn btn-sm btn-primary\" ng-if=\"canIEdit\" ng-click=\"toggleEditMode()\" ng-show=\"!inEditMode\">Editar</button>\n      <button class=\"btn btn-sm btn-success\" ng-if=\"canIEdit\" ng-click=\"savePieceValues()\" ng-show=\"inEditMode\">Salvar</button>\n      <button class=\"btn btn-sm btn-danger\" ng-if=\"inEditMode\" ng-click=\"cancelPieceValuesEdit()\">Cancelar</button>\n      <div class=\"btn-group decimal-places\" ng-if=\"!inEditMode\">\n        <button class=\"btn btn-default btn-set-decimals\" type=\"button\" title=\"Menos casas decimais\" ng-click=\"setDecimalPlaces(-1)\">,0</button>\n        <button class=\"btn btn-default btn-set-decimals\" type=\"button\" title=\"Mais casas decimais\" ng-click=\"setDecimalPlaces(1)\">,00</button>\n      </div>\n      <button type=\"button\" class=\"close-icon\" title=\"Fechar\" aria-label=\"Fechar\" ng-click=\"hidePanel()\"><i class=\"fa fa-times\" aria-hidden=\"true\"></i></button>\n    </div>\n\n    <progress loading=\"loading\" class=\"loading-importing-spinner loading-car-prototype-pattern\"></progress>\n\n    <uib-tabset class=\"list-pieces-tabs\" active=\"0\" ng-show=\"!loading\">\n      <uib-tab index=\"0\" heading=\"Por profundidade\" select=\"groupListPiecesBy('size')\">\n        <div class=\"div-table group-by-size custom-scroll\" ng-class=\"{'visible': listPieceGroupByProperty === 'size'}\">\n          <div class=\"list-piece-value-container\" ng-repeat=\"(size, pieces) in pieceValues\">\n            <div class=\"list-piece-value\">\n              <div class=\"list-piece-element\" ng-bind=\"size\"></div>\n\n              <div class=\"list-piece-profs custom-scroll\">\n                <div class=\"list-piece-prof-by-name\" ng-repeat=\"piece in pieces | orderBy:'name'\" ng-class=\"{'changed': piece.changed, 'save-error': piece.saveError}\">\n                  <div class=\"list-piece-prof-name\" ng-bind=\"piece.name\"></div>\n                  <div class=\"list-piece-prof-value\" ng-bind=\"piece.value|number:decimalPlaces\" ng-show=\"!inEditMode\"></div>\n                  <input type=\"number\" class=\"list-piece-prof-input\" ng-model=\"piece.value\" ng-show=\"inEditMode\" ng-change=\"checkValueChanged(piece)\" />\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </uib-tab>\n\n      <uib-tab index=\"1\" heading=\"Por elemento\" select=\"groupListPiecesBy('name')\">\n        <div class=\"div-table group-by-name custom-scroll\" ng-class=\"{'visible': listPieceGroupByProperty === 'name'}\">\n          <div class=\"list-piece-value-container\" ng-repeat=\"(element, pieces) in pieceValues\">\n            <div class=\"list-piece-value\">\n              <div class=\"list-piece-element\" ng-bind=\"element\"></div>\n\n              <div class=\"list-piece-profs custom-scroll\">\n                <div class=\"list-piece-prof-by-size\" ng-repeat=\"piece in pieces | orderBy:'size'\" ng-class=\"{'changed': piece.changed, 'save-error': piece.saveError}\" title=\"{{ piece.saveError ? 'Não foi possível salvar este valor. O valor original foi restaurado.' : '' }}\">\n                  <div class=\"list-piece-prof-name\" ng-bind=\"piece.size\"></div>\n                  <div class=\"list-piece-prof-value\" ng-bind=\"piece.value|number:decimalPlaces\" ng-show=\"!inEditMode\"></div>\n                  <input type=\"number\" class=\"list-piece-prof-input\" ng-model=\"piece.value\" ng-show=\"inEditMode\" ng-change=\"checkValueChanged(piece)\" />\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </uib-tab>\n    </uib-tabset>\n  </div>\n</div>\n<version-verifier url=\"{{versionUrl}}\" version=\"2.1.0\" notify-outside=\"true\"/>\n"
          },
          "redirectURL": "",
