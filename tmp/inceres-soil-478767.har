          "content": {
            "size": 12825,
            "mimeType": "text/html",
            "text": "<div ng-controller=\"ToolsInfoController\">\n  <div class=\"tool-info-panel-div\" ng-if=\"showToolInfo\">\n    <div class=\"row panel-header\">\n      <div class=\"tool-case-type\">{{ tool.exibitionTool }} {{ size.size | layerLabel }} {{ infoTool.unit }} </div>\n      <i class=\"fa fa-times close-icon\" ng-click=\"closeToolInfoPanel()\" aria-hidden=\"true\"></i>\n    </div>\n\n    <ul class=\"tool-info-tabs\" ng-class=\"{'bing-mode' : satelliteLayerOn}\">\n      <li>\n        <a title=\"Legenda e Estatística\" class=\"btn-graph\" ng-class=\"{'activated-tool': showPanelLegendStatistics}\" ng-click=\"showLegendStatistics()\">\n          <span class=\"icon-statistics\"></span>\n        </a>\n      </li>\n      <li>\n        <a title=\"Estilos\" class=\"btn-statistic\" ng-class=\"{'activated-tool': showPanelStyles}\" ng-click=\"showStyles()\">\n          <span class=\"icon-stilo\"></span>\n        </a>\n      </li>\n      <li ng-if=\"!state.isUgd\">\n        <a title=\"Configuração\" class=\"btn-cog \" ng-class=\"{'activated-tool': showPanelConfiguration}\" ng-click=\"showConfiguration()\">\n          <span class=\"icon-confg\"></span>\n        </a>\n      </li>\n    </ul>\n\n    <div class=\"tool-info-tabs-contents custom-scroll\">\n      <div ng-if=\"showPanelLegendStatistics\" class=\"tool-info-tab-content\" ng-class=\"{'visible': panelLegendStatisticsVisible}\">\n        <progress loading=\"size.calculating\" class=\"spinner list-tools-info-loading\"></progress>\n\n        <div class=\"row-legend\" ng-if=\"!size.calculating\">\n          <h4>LEGENDA</h4>\n\n          <div class=\"col-md-12\">\n            <div class=\"btn-group decimal-places\">\n              <button class=\"btn btn-default btn-set-decimals\" type=\"button\" ng-click=\"setDecimalPlaces(-1)\">,0<i class=\"fa fa-long-arrow-left\"></i></button>\n              <button class=\"btn btn-default btn-set-decimals\" type=\"button\" ng-click=\"setDecimalPlaces(1)\">,00<i class=\"fa fa-long-arrow-right\"></i></button>\n            </div>\n          </div>\n\n          <component-charts chart=\"toolGraph\" decimal-places=\"decimalPlaces\" show-sub-title=\"showSubTitle\"></component-charts>\n\n          <div class=\"col-md-12\">\n            <label class=\"switch-tool-infos\">\n              <input type=\"checkbox\" ng-click=\"showLegend()\">\n              <span class=\"slider round\"></span>\n            </label>\n            Legenda\n          </div>\n        </div>\n\n        <div class=\"row-statistics\" ng-if=\"!size.calculating\">\n          <h4>ESTATÍSICA</h4>\n\n          <div class=\"col-md-12 percent\">\n            <label>{{ tool.exibitionTool }} {{ size.size | layerLabel }}</label> está presente em {{ infoTool.percent }}% dos pontos na camada.\n          </div>\n\n          <div class=\"col-md-12\">\n            <div class=\"info-panel-statistics\">\n              <div class=\"field-statitics\" ng-repeat=\"stat in stats\">\n                <div class=\"statistics\">\n                  <span class=\"statistics-title\" ng-bind=\"stat.field\"></span>\n                  <button class=\"btn btn-collapse\" ng-click=\"stat.collapsed = !stat.collapsed\">\n                    <i class=\"fa\" ng-class=\"{'fa-caret-up': !stat.collapsed, 'fa-caret-down': stat.collapsed}\"></i>\n                  </button>\n                  <span class=\"value\" ng-bind=\"stat.totalArea.floatAsString(decimalPlaces)\"></span>\n                </div>\n\n                <div class=\"collapsable\" uib-collapse=\"stat.collapsed\">\n                  <div class=\"statistics\">Média: <span class=\"value\" ng-bind=\"stat.mean.floatAsString(decimalPlaces)\"></span></div>\n                  <div class=\"statistics\">Mínimo: <span class=\"value\" ng-bind=\"stat.min.floatAsString(decimalPlaces)\"></span></div>\n                  <div class=\"statistics\">Máximo: <span class=\"value\" ng-bind=\"stat.max.floatAsString(decimalPlaces)\"></span></div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div ng-if=\"showPanelStyles\" class=\"tool-info-tab-content\" ng-class=\"{'visible': panelStylesVisible}\">\n        <progress loading=\"size.calculating\" class=\"spinner list-tools-info-loading\"></progress>\n\n        <div class=\"row-styles\" ng-if=\"!size.calculating\">\n          <h4>ESTILOS</h4>\n\n          <div class=\"tools-info-options\">\n            <div class=\"tools-info-option\">\n              <div class=\"btn-group decimal-places\">\n                <button class=\"btn btn-default btn-set-decimals\" type=\"button\" ng-click=\"setDecimalPlaces(-1)\">,0<i class=\"fa fa-long-arrow-left\"></i></button>\n                <button class=\"btn btn-default btn-set-decimals\" type=\"button\" ng-click=\"setDecimalPlaces(1)\">,00<i class=\"fa fa-long-arrow-right\"></i></button>\n              </div>\n            </div>\n\n            <div class=\"tools-info-option\">\n              <label>Classificador</label>\n              <button type=\"button\" class=\"btn btn-default dropdown-toggle motors-dropdown\" data-toggle=\"dropdown\" aria-haspopup=\"true\" aria-expanded=\"false\">\n                {{infoTool.style.classification.name}} <span class=\"caret style-classifier-dropdown-icon\"></span>\n              </button>\n              <ul class=\"dropdown-menu\">\n                <li ng-repeat=\"classification in classifications\"><a ng-click=\"applyInfoToolStyleClassification(classification)\" href=\"#\" ng-bind=\"classification.name\"></a></li>\n              </ul>\n            </div>\n\n            <div class=\"tools-info-option\">\n              <label>Rampa de Cores</label>\n              <button type=\"button\" class=\"btn btn-default dropdown-toggle motors-dropdown\" data-toggle=\"dropdown\" aria-haspopup=\"true\" aria-expanded=\"false\">\n                {{colorsRamp.selected.text}} <span class=\"caret style-classifier-dropdown-icon\"></span>\n              </button>\n              <ul class=\"dropdown-menu dropdown-colors-ramp custom-scroll\">\n                <li>\n                  <input type=\"text\" ng-model=\"colorsRamp.search\" class=\"form-control input-search-colors-ramp\" id=\"\" placeholder=\"Buscar Rampa de Cores\">\n                </li>\n                <li ng-repeat=\"colorOption in colorOptions | filter:{text: colorsRamp.search}\" ng-class=\"{'selected': colorOption.id === colorsRamp.selected.id}\">\n                  <a class=\"ramp-color\" ng-click=\"setColorRamp(colorOption)\">\n                    <div>\n                      <img ng-src=\"{{colorOption.img}}\"> {{colorOption.text}}\n                    </div>\n                  </a>\n                </li>\n              </ul>\n            </div>\n\n            <div class=\"tools-info-option\">\n              <button type=\"button\" class=\"btn btn-default btn-add-color\" ng-click=\"addCustomColor('darken')\"><i class=\"fa fa-plus\"></i> Cor escura</button>\n              <button type=\"button\" class=\"btn btn-default btn-add-color add-light\" ng-click=\"addCustomColor('lighten')\"><i class=\"fa fa-plus\"></i> Cor clara</button>\n            </div>\n\n            <div class=\"tools-info-option\">\n              <label class=\"switch-tool-infos\">\n                <input type=\"checkbox\" ng-model=\"infoTool.style.usingStatisticMinValue\">\n                <span class=\"slider round\"></span>\n              </label>\n              Valor mínimo da estatística\n            </div>\n\n            <div class=\"tools-info-option\">\n              <span class=\"min-value-label\">Valor Mínimo:</span>\n              <input type=\"number\" class=\"min-value-input\" ng-model=\"infoTool.style.minimumValue\" ng-show=\"!infoTool.style.usingStatisticMinValue\" />\n              <span class=\"min-value-span\" ng-bind=\"infoTool.style.minimumValue.floatAsString(decimalPlaces)\" ng-show=\"infoTool.style.usingStatisticMinValue\"></span>\n            </div>\n\n            <div class=\"tools-info-option\">\n              <div class=\"number-text\">{{ toolGraph.data.length }} Cores</div>\n              <div class=\"tool-info-graph-data-row\" ng-repeat=\"(key, data) in toolGraph.data\">\n                <input type=\"color\" class=\"color-input\" ng-model=\"data.color\">\n                <input type=\"number\" class=\"color-tool-value-input\" ng-model=\"data.liSup\" ng-show=\"!infoTool.style.autoStyle\">\n                <span class=\"color-tool-value-span\" ng-bind=\"data.liSup.floatAsString(decimalPlaces)\" ng-show=\"infoTool.style.autoStyle\"></span>\n                <i class=\"fa fa-times remove-color-icon\" ng-class=\"{'with-span': infoTool.style.autoStyle}\" aria-hidden=\"true\" ng-click=\"removeColor(key)\"></i>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div ng-if=\"!state.isUgd && showPanelConfiguration\" class=\"tool-info-tab-content\" ng-class=\"{'visible': panelConfigurationVisible}\">\n        <progress loading=\"size.calculating\" class=\"spinner list-tools-info-loading\"></progress>\n\n        <div class=\"row-configuration\" ng-if=\"!size.calculating\">\n          <h4>CONFIGURAÇÃO</h4>\n\n          <div class=\"tools-info-options\" ng-if=\"!size.calculating\">\n            <div class=\"tools-info-option\">\n              <label>Interpolador</label>\n              <select ng-model=\"infoTool.makeProcess\" class=\"form-control\" ng-if=\"!state.isUgd\" ng-options=\"interpolator as interpolator.name for interpolator in interpolators\">\n              </select>\n            </div>\n\n            <div class=\"tools-info-option\" ng-if=\"infoTool.makeProcess.name.indexOf('Kriging') !== -1\">\n              <div class=\"krigging-option\">\n                <label tabindex=\"0\" uib-tooltip=\"Tamanho ótimo da grade amostral para melhor caracterização da interprolação.\" tooltip-placement=\"top-left\" tooltip-trigger=\"focus\">\n                  Alcance:\n                  <i class=\"fa fa-question-circle\" aria-hidden=\"true\"></i>\n                </label>\n                <input class=\"form-control\" type=\"number\" ng-model=\"infoTool.makeProcess.params.range\">\n              </div>\n              <div class=\"krigging-option\">\n                <label tabindex=\"0\" uib-tooltip=\"Máxima variação do valor atributo analisado\" tooltip-placement=\"bottom\" tooltip-trigger=\"focus\">\n                  Patamar:\n                  <i class=\"fa fa-question-circle\" aria-hidden=\"true\"></i>\n                </label>\n                <input class=\"form-control\" type=\"number\" ng-model=\"infoTool.makeProcess.params.sill\">\n              </div>\n              <div class=\"krigging-option\">\n                <label tabindex=\"0\" uib-tooltip=\"Aleatoriedade da variabilidade entre micro distâncias\" tooltip-placement=\"top-left\" tooltip-trigger=\"focus\">\n                  Pepita:\n                  <i class=\"fa fa-question-circle\" aria-hidden=\"true\"></i>\n                </label>\n                <input class=\"form-control\" type=\"number\" ng-model=\"infoTool.makeProcess.params.nugget\">\n              </div>\n            </div>\n\n            <div class=\"tools-info-option\" ng-if=\"infoTool.makeProcess.name.indexOf('IDW') !== -1\">\n              <div class=\"idw-option\">\n                <label tabindex=\"0\" uib-tooltip=\"Quão maior for  o valor menor será o efeito de suavização da interpolação.\" tooltip-placement=\"top-left\" tooltip-trigger=\"focus\">\n                  Potência:\n                  <i class=\"fa fa-question-circle\" aria-hidden=\"true\"></i>\n                </label>\n                <input class=\"form-control\" type=\"number\" ng-model=\"infoTool.makeProcess.params.power\">\n              </div>\n              <div class=\"idw-option\">\n                <label tabindex=\"0\" uib-tooltip=\"Define o número de amostragens (valores mais próximos) a serem utilizados no pixel a ser interpolado.\" tooltip-placement=\"bottom\" tooltip-trigger=\"focus\">\n                  Vizinhos:\n                  <i class=\"fa fa-question-circle\" aria-hidden=\"true\"></i>\n                </label>\n                <input class=\"form-control\" type=\"number\" ng-model=\"infoTool.makeProcess.params.neighbors\">\n              </div>\n            </div>\n\n            <div class=\"tools-info-option\">\n              <label class=\"switch-tool-infos\">\n                <input type=\"checkbox\" ng-model=\"infoTool.filtration.filter\">\n                <span class=\"slider round\"></span>\n              </label>\n              Filtrar dados\n            </div>\n\n            <div class=\"tools-info-option\" ng-show=\"infoTool.filtration.filter\">\n              <label>\n                Fator da filtragem: <i class=\"fa fa-question-circle\" aria-hidden=\"true\" uib-tooltip=\"Valor que define quão rígida será a filtragem dos dados discrepantes\" tooltip-placement=\"top-left\" tooltip-placement=\"top-left\" tooltip-trigger=\"focus\"></i>\n              </label>\n              <input class=\"form-control filter-option\" type=\"number\" ng-model=\"infoTool.filtration.factor\">\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"tools-info-footer\">\n      <button type=\"button\" class=\"btn btn-success\" ng-disabled=\"size.calculating\" ng-click=\"recalcInteporlation()\"><i class=\"fa fa-save\"></i></button>\n    </div>\n  </div>\n</div>\n<version-verifier url=\"{{versionUrl}}\" version=\"2.1.0\" notify-outside=\"true\"/>\n"
          },
