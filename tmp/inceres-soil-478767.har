            "text": "<div class=\"home\">\n\n  <div class=\"custom-map\" ng-class=\"{'bing-mode' : satelliteLayerOn}\">\n    <div ng-include=\"'templates/include/ol-map.html'\"></div>\n  </div>\n\n  <div ng-class=\"{'list-areas-panel' : areListAreasVisible, 'list-areas-panel-hidden' : !areListAreasVisible, 'list-areas-panel-expanded': areListAreasExpanded, 'collapsed' : sidebarCollapsed, 'bing-mode' : satelliteLayerOn}\" ng-include=\"'templates/include/list-areas.html'\"></div>\n\n  <div ng-class=\"{'visible': listCarSecitonOpen,  'list-amostragens-panel' : areListAreasVisible, 'list-amostragens-panel-full' : !areListAreasVisible, 'collapsed' : sidebarCollapsed, 'bing-mode' : satelliteLayerOn }\" ng-include=\"'templates/include/list-amostragens.html'\"></div>\n\n  <section class=\"info-panel\" ng-class=\"{'bing-mode' : satelliteLayerOn, 'visible': showInfo}\" ng-include=\"'templates/info-panel.html'\"></section>\n\n  <section class=\"integration-panel\" ng-class=\"{'bing-mode' : satelliteLayerOn}\"  ng-style=\"{display: showIntegrationModal ? 'block' : 'none'}\" ng-include=\"'templates/include/integration-form.html'\"></section>\n\n  <section class=\"car-creation-panel\" ng-class=\"{'collapsed' : sidebarCollapsed, 'bing-mode' : satelliteLayerOn}\" ng-include=\"'templates/include/grid-config.html'\"></section>\n\n  <section class=\"zones-infos\" ng-class=\"{'bing-mode' : satelliteLayerOn}\" ng-style=\"{display: showResumeTable ? 'block' : 'none'}\" ng-include=\"'templates/include/zone-infos.html'\"></section>\n\n  <section class=\"car-panel-edition-actions\" ng-class=\"{'bing-mode' : satelliteLayerOn}\"  ng-style=\"{display: editionSectionOpen ? 'block' : 'none'}\" ng-include=\"'templates/include/car-edition-actions.html'\"></section>\n\n  <section class=\"car-panel-edition-actions-ugd\" ng-class=\"{'bing-mode' : satelliteLayerOn}\"  ng-style=\"{display: editionSectionOpenUGD ? 'block' : 'none'}\" ng-include=\"'templates/include/car-edition-actions.html'\"></section>\n\n  <section ng-class=\"{'bing-mode' : satelliteLayerOn}\" ng-include=\"'templates/include/ndvi-panel-show.html'\"></section>\n\n  <section class=\"info-tools-panel\"  ng-class=\"{'bing-mode' : satelliteLayerOn, 'visible': toolInfoVisible}\" ng-include=\"'templates/include/list-tool-infos.html'\"></section>\n\n  <alexandria-grid-pattern ng-if=\"alexandriaIframeIsOpen\"></alexandria-grid-pattern>\n\n  <alexandria-fertility-pattern ng-if=\"alexandriaFertilityIframeIsOpen\"></alexandria-fertility-pattern>\n\n  <section ng-class=\"{'bing-mode' : satelliteLayerOn}\"  ng-style=\"{display: editionSectionOpen ? 'block' : 'none'}\" ng-include=\"'templates/include/integration-form.html'\"></section>\n\n  <section ng-class=\"{'bing-mode' : satelliteLayerOn}\"  ng-include=\"'templates/include/overlap-layers-visualizer.html'\"></section>\n\n  <div class=\"list-pieces-value-panel\" ng-class=\"{'bing-mode' : satelliteLayerOn, 'visible': showPieceValues}\" ng-include=\"'templates/include/list-pieces-value.html'\"></div>\n\n  <div class=\"import-from-v2 bigger opened\" ng-if=\"modalImportCarFromV2Open\">\n    <kgb></kgb>\n  </div>\n\n  <div ng-style=\"{display: searchInfoSectionOpen ? 'block' : 'none'}\"  ng-class=\"{'bing-mode' : satelliteLayerOn}\" class=\"search-piece-panel\" ng-include=\"'templates/include/search-piece.html'\"></div>\n\n  <div ng-controller=\"GridSyncModalController\">\n    <div class=\"grid-sync-modal opened\" ng-if=\"isGridSyncModalOpen\" ng-class=\"{'bing-mode' : previewState.isSatelliteOn}\" ng-include=\"'templates/include/grid-sync-modal.html'\"></div>\n  </div>\n\n  <button class=\"dock-button\" ng-class=\"{'collapsed' : sidebarCollapsed, 'full-panel' : !areListAreasVisible, 'bing-mode' : satelliteLayerOn}\" ng-click=\"sidebarCollapsed = !sidebarCollapsed\">\n    <i class=\"fa fa-chevron-left\" ng-if=\"!sidebarCollapsed\"></i>\n    <i class=\"fa fa-chevron-left\" ng-if=\"!sidebarCollapsed\"></i>\n    <i class=\"fa fa-chevron-right\" ng-if=\"sidebarCollapsed\"></i>\n    <i class=\"fa fa-chevron-right\" ng-if=\"sidebarCollapsed\"></i>\n  </button>\n\n  <div class=\"progress-status\" ng-class=\"{'im-alive': progressStatus.somethingIsHappenInTheSky}\" ng-bind=\"progressStatus.message\"></div>\n</div>\n\n<version-verifier url=\"{{versionUrl}}\" version=\"2.1.0\" notify-outside=\"true\"/>\n"
          },
