          "content": {
            "size": 3510,
            "mimeType": "text/html",
            "text": "<div class=\"list-tools\" ng-controller=\"ToolsController\" ng-if=\"toolPanelOpen\">\n  <section ng-include=\"'templates/modal-car-tools-pattern.html'\"></section>\n\n  <div class=\"panel-body-depth\" ng-if=\"loading\">\n    <progress loading=\"loading\" class=\"spinner loading-amostragens\"></progress>\n  </div>\n\n  <div ng-if=\"!loading\" class=\"elements-table-header\">\n    <i class=\"fa fa-times close-icon\" aria-hidden=\"true\" ng-click=\"closeToolPanel()\"></i>\n    <table class=\"table\">\n      <thead>\n      <tr>\n        <th class=\"col-fertilidade\" ng-bind=\"elementsColumnLabel()\"></th>\n        <th class=\"col-profundidade\" ng-bind=\"layersColumnLabel()\"></th>\n      </tr>\n      </thead>\n    </table>\n  </div>\n\n  <section ng-include=\"'templates/modal_info.html'\"></section>\n\n  <div ng-if=\"!loading\" class=\"list-tools-tools-sizes custom-scroll\">\n    <div class=\"tool-size-row\" ng-repeat=\"tool in tools\" ng-class=\"{'tool-selected' : tool.selected}\">\n      <div class=\"tool-name-cell\">{{ tool.exibitionTool }}</div>\n\n      <div class=\"tool-sizes-cells\">\n        <div class=\"tool-size-cell\" ng-class=\"{'size-selected' : size.selected, 'with-more-than-4': tool.sizes.length > 4}\" ng-repeat=\"size in tool.sizes\" ng-click=\"seeMyTool(tool, size)\">\n          <div class=\"tool-size-cell-value\" title=\"{{ size.size | layerLabel }} - Interpolação já calculada\" ng-if=\"isSizeInterpolated(size)\">{{ size.size | layerShortLabel }}</div>\n\n          <div class=\"tool-size-cell-value\" title=\"{{ size.errorMessage }}\" ng-if=\"size.errorMessage\">\n            <i class=\"fa fa-warning status-error\"></i>\n          </div>\n\n          <div class=\"tool-size-cell-value\" title=\"Interpolação não iniciada. Clique para calcular\" ng-if=\"isSizeNotStarted(size)\">\n            <i class=\"fa fa-play-circle status-not-started\"></i>\n          </div>\n\n          <div class=\"tool-size-cell-value\" title=\"Interpolação aguardando para ser calculada\" ng-if=\"isSizeWaitingToStart(size)\">\n            <i class=\"fa fa-hourglass-start status-waiting\"></i>\n          </div>\n\n          <fertilityprogress title=\"Essa profundidade está sendo interpolada\" loading=\"size.calculating\" class=\"loading-fertilidades status-calculating\"></fertilityprogress>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"tools-bottom\" ng-if=\"!loading\">\n    <div class=\"row pattern-name\" ng-show=\"car.fertilityPattern && usesFertilityPattern()\">\n      <div class=\"col-md-12\">\n        <label>Padrão: </label> {{ car.fertilityPattern }}\n      </div>\n    </div>\n    <div class=\"row\">\n      <div class=\"col-md-4 col-sm-4 col-xs-4\" ng-if=\"usesFertilityPattern()\">\n        <button type=\"button\" class=\"btn btn-default btn-tools-option\" ng-click=\"openCarToolPattern(tools)\" title=\"Enviar processamento como padrão para a biblioteca\">\n          <i class=\"icon-alexandria\"></i>\n        </button>\n      </div>\n      <div class=\"col-md-4 col-sm-4 col-xs-4\" ng-if=\"usesFertilityPattern()\">\n        <button type=\"button\" class=\"btn btn-default btn-tools-option\" ng-click=\"usePatternFromAlexandria()\" title=\"Trocar Padrão de Interpolação\">\n          <i class=\"fa fa-book\" aria-hidden=\"true\"></i>\n        </button>\n      </div>\n      <div class=\"col-md-4 col-sm-4 col-xs-4\">\n        <button type=\"button\" class=\"btn btn-default btn-tools-option\" ng-click=\"fixErrors()\" title=\"Corrigir erros\">\n          <i class=\"fa fa-wrench\" aria-hidden=\"true\"></i>\n        </button>\n      </div>\n    </div>\n  </div>\n</div>\n\n<version-verifier url=\"{{ versionUrl }}\" version=\"2.1.0\" notify-outside=\"true\"/>\n"
          },
