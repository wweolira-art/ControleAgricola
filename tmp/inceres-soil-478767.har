          "content": {
            "size": 1246,
            "mimeType": "text/html",
            "text": "<div ng-controller=\"OverlapLayersVisualizerController\">\n\n  <section class=\"layers-comparison-card\" ng-hide=\"ndvibarCollapsed\" ng-if=\"sliderToggle\" aria-label=\"Comparação entre camadas\">\n    <div class=\"layers-comparison-header\">\n      <label class=\"layers-comparison-title\" for=\"layers-comparison-range\">Comparar camadas</label>\n      <span class=\"layers-comparison-current-layer\" aria-hidden=\"true\" title=\"{{ describeComparisonPosition() }}\" ng-bind=\"describeComparisonPosition()\"></span>\n      <button type=\"button\" class=\"layers-comparison-close\" ng-click=\"closeZoneLayers()\" title=\"Fechar\" aria-label=\"Fechar camadas da zona\">\n        <i class=\"fa fa-times\" aria-hidden=\"true\"></i>\n      </button>\n    </div>\n\n    <input id=\"layers-comparison-range\" class=\"layers-comparison-range\" type=\"range\" min=\"0\" max=\"{{ ::sliderMax }}\"\n           ng-model=\"state.sliderValue\" aria-valuetext=\"{{ describeComparisonPosition() }}\">\n\n    <ol class=\"layers-comparison-labels\" ng-style=\"buildLabelColumnsStyle()\">\n      <li class=\"layers-comparison-label\" ng-repeat=\"layer in chassisLayers\" title=\"{{ layer.name }}\" ng-bind=\"layer.name\"></li>\n    </ol>\n  </section>\n</div>\n\n<version-verifier url=\"{{ versionUrl }}\" version=\"2.1.0\" notify-outside=\"true\"/>\n"
          },
