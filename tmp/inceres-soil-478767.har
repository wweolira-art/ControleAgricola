          "content": {
            "size": 2475,
            "mimeType": "text/html",
            "text": "<div class=\"new-sampling-modal navy-heading-modal merge-pattern-modal pattern-picker\" ng-class=\"{'opened': chooseFertilitiesPatternModalOpen}\">\n  <div class=\"modal-view\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"mergePatternModalTitle\">\n    <div class=\"modal-heading\">\n      <div class=\"title-row\">\n        <span class=\"title\" id=\"mergePatternModalTitle\">Qual padrão deseja utilizar?</span>\n        <button type=\"button\" class=\"close-button\" ng-click=\"closeFertilitiesPatternPopup()\" title=\"Fechar\" aria-label=\"Fechar\">\n          <i class=\"fa fa-times\" aria-hidden=\"true\"></i>\n        </button>\n      </div>\n    </div>\n\n    <div class=\"pattern-tabs\" role=\"tablist\">\n      <button type=\"button\" class=\"pattern-tab\" role=\"tab\"\n              ng-repeat=\"tab in mergePatternTabs\"\n              id=\"mergePatternTab-{{tab.key}}\"\n              aria-controls=\"mergePatternPanel\"\n              ng-class=\"{'active': mergePatternTab === tab.key}\"\n              aria-selected=\"{{mergePatternTab === tab.key}}\"\n              uib-tooltip=\"{{tab.hint}}\" tooltip-placement=\"bottom\"\n              ng-click=\"selectMergePatternTab(tab.key)\">\n        {{tab.label}}\n      </button>\n    </div>\n\n    <div class=\"modal-body custom-scroll\" id=\"mergePatternPanel\" role=\"tabpanel\" aria-labelledby=\"mergePatternTab-{{mergePatternTab}}\">\n      <div class=\"pattern-feedback\" ng-if=\"patternsLoading\">\n        <i class=\"fa fa-spinner fa-spin\" aria-hidden=\"true\"></i> Carregando padrões...\n      </div>\n\n      <div ng-if=\"!patternsLoading\">\n        <div ng-repeat=\"group in mergePatternGroups\" ng-include=\"'templates/include/pattern-option-list.html'\"></div>\n\n        <div ng-if=\"mergePatternTab === mergePatternTabKeys.SYSTEM\">\n          <div class=\"pattern-list\">\n            <label class=\"pattern-option\" ng-class=\"{'selected': patternSelected.id === systemPattern.id}\">\n              <input type=\"radio\" name=\"patterns\" ng-model=\"patternSelected.id\" ng-value=\"systemPattern.id\">\n              <span>Padrão do Sistema</span>\n            </label>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"modal-footer-actions\">\n      <button type=\"button\" class=\"dismiss-button\" ng-click=\"closeFertilitiesPatternPopup()\">Cancelar</button>\n      <button type=\"button\" class=\"confirm-button\" ng-disabled=\"!patternSelected.id\" ng-click=\"mergeAllCars(carsToMerge)\">Unir</button>\n    </div>\n  </div>\n</div>\n\n<version-verifier url=\"{{versionUrl}}\" version=\"2.1.0\" notify-outside=\"true\"/>\n"
