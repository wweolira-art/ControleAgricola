          "content": {
            "size": 6476,
            "mimeType": "text/html",
            "text": "<section class=\"main\" ng-class=\"{'collapsed': sidebarBehavior, 'bing-layer-on': bingLayerOn}\">\n  <div class=\"main-left-menu col-md-12 col-sm-12 col-xs-12\">\n    <div class=\"options-left-menu col-md-2 col-sm-2 col-xs-2\">\n\n      <ul class=\"nav products-tab\" ng-if=\"operationType === 'PA'\">\n        <li ng-if=\"canIAccessSoilData\">\n          <a title=\"Amostragem\" ui-sref=\"openMotorsState\">\n            <span class=\"icon-amostragem\"></span>\n            <small>Amos...</small>\n          </a>\n        </li>\n        <li ng-if=\"canIAccessFertilityData\">\n          <a title=\"Fertilidade\" ui-sref=\"listPaFertilityState\" ng-class=\"{'selected': openedTab === 'fertility'}\">\n            <span class=\"icon-fertility fertility\"></span>\n            <small>Fert...</small>\n          </a>\n        </li>\n        <li ng-if=\"canIAccessBioanalysisData\">\n          <a title=\"Bioanálise\" ui-sref=\"listBioanalysisState\" ng-class=\"{'selected': openedTab === 'bioanalysis'}\">\n            <span class=\"icon-bioas\"></span>\n            <small>Bioa...</small>\n          </a>\n        </li>\n         <li ng-if=\"canIAccessLeafData\">\n          <a title=\"Análise Foliar\" ui-sref=\"listLeafState\" ng-class=\"{'selected': openedTab === 'leaf'}\">\n            <span class=\"icon-leaf\"></span>\n            <small>Foliar</small>\n          </a>\n        </li>\n        <li ng-if=\"canIAccessPermanentData\">\n          <a class=\"permanent\" title=\"Permanente\" ui-sref=\"listPaPermanentState\" ng-class=\"{'selected': openedTab === 'permanent'}\">\n            <span class=\"icon-permanente permanent\"></span>\n            <small>Perm...</small>\n          </a>\n        </li>\n        <li ng-if=\"canIAccessProductivityData\">\n          <a title=\"Produtividade\" ui-sref=\"listPaProductivityState\" ng-class=\"{'selected': openedTab === 'productivity'}\">\n            <span class=\"fa fa-line-chart productivity\"></span>\n            <small>Prod...</small>\n           </a>\n        </li>\n        <li ng-if=\"canIAccessElectricConductivityData\">\n          <a title=\"Condutividade Elétrica\" ui-sref=\"listPaElectricConductivityState\" ng-class=\"{'selected': openedTab === 'electricConductivity'}\">\n            <span class=\"icon-electric-conductivity\"></span>\n            <small>CE</small>\n          </a>\n        </li>\n        <li ng-if=\"canIAccessSatImageData\">\n          <a title=\"Imagens de Satelite\" ui-sref=\"listPaSatImageState\" ng-class=\"{'selected': openedTab === 'satImage'}\">\n            <span class=\"icon-satellite\"></span>\n            <small>Sate...</small>\n          </a>\n        </li>\n        <li ng-if=\"canIAccessCompactionData\">\n          <a title=\"Compactação\" ui-sref=\"listCompactionState\" ng-class=\"{'selected': openedTab === 'compaction'}\">\n            <span class=\"icon-descompact\"></span>\n            <small>Comp...</small>\n          </a>\n        </li>\n        <li ng-if=\"canIAccessAlgebraData\">\n          <a title=\"Álgebra de Mapas\" ui-sref=\"listAlgebraState\" ng-class=\"{'selected': openedTab === 'algebra'}\">\n            <span class=\"icon-algebra\"></span>\n            <small>Álge...</small>\n          </a>\n        </li>\n        <li ng-if=\"canIAccessPestsData\">\n          <a title=\"Pragas\" ui-sref=\"listPestState\" ng-class=\"{'selected': openedTab === 'pest'}\">\n            <span class=\"icon-pest\"></span>\n            <small>Prag...</small>\n          </a>\n        </li>\n        <li ng-if=\"canIAccessRecommendationData\">\n          <a title=\"Recomendação\" ui-sref=\"listPaRecommendationState\" ng-class=\"{'selected': openedTab === 'recommendation'}\">\n            <span class=\"icon-npk\"></span>\n            <small>Reco...</small>\n          </a>\n        </li>\n        <li ng-if=\"canIAccessAsAppliedData\">\n          <a title=\"As Applied\" ui-sref=\"listPaAsAppliedsState\" ng-class=\"{'selected': openedTab === 'as-applied'}\">\n            <span class=\"icon-as-applied\"></span>\n            <small>As&nbsp;Ap...</small>\n          </a>\n        </li>\n      </ul>\n\n      <ul class=\"nav\" ng-if=\"operationType === 'CA'\">\n        <li ng-if=\"canIAccessCaFertilityData\">\n          <a title=\"Fertilidade\" ui-sref=\"listCaFertilityState\" ng-class=\"{'selected': openedTab === 'fertility'}\">\n            <span class=\"icon-fertility fertility\"></span>\n            <small>Fert...</small>\n          </a>\n        </li>\n        <li ng-if=\"canIAccessCaFertilityLeafData\">\n          <a title=\"Foliar\" ui-sref=\"listCaFertilityLeafState\" ng-class=\"{'selected': openedTab === 'leaf'}\">\n            <span class=\"icon-fertility fertility\"></span>\n            <small>Foliar</small>\n          </a>\n        </li>\n        <li ng-if=\"canIAccessCaPermanentData\">\n          <a class=\"permanent\" title=\"Permanente\" ui-sref=\"listCaPermanentState\" ng-class=\"{'selected': openedTab === 'permanent'}\">\n            <span class=\"icon-permanente permanent\"></span>\n            <small>Perm...</small>\n          </a>\n        </li>\n        <li ng-if=\"canIAccessCaProductivityData\">\n          <a title=\"Produtividade\" ui-sref=\"listCaProductivityState\" ng-class=\"{'selected': openedTab === 'productivity'}\">\n            <span class=\"fa fa-line-chart productivity\"></span>\n            <small>Prod...</small>\n          </a>\n        </li>\n        <li ng-if=\"canIAccessSatImageData\">\n          <a title=\"Imagens de Satelite\" ui-sref=\"listCaSatImageState\" ng-class=\"{'selected': openedTab === 'satImage'}\">\n            <span class=\"icon-satellite\"></span>\n            <small>Sate...</small>\n          </a>\n        </li>\n        <li ng-if=\"canIAccessCaAutomaticRecommendationData\">\n          <a title=\"Recomendação Automática\" ui-sref=\"listFlCaRecommendationState\" ng-class=\"{'selected': openedTab === 'fl-recommendation'}\">\n            <span class=\"icon-npk\"></span>\n            <small>Reco...</small>\n          </a>\n        </li>\n        <li ng-if=\"canIAccessCaRecommendationData\">\n          <a title=\"Recomendação\" ui-sref=\"listCaRecommendationState\" ng-class=\"{'selected': openedTab === 'recommendation'}\">\n            <span class=\"icon-npk\"></span>\n            <small>Reco...</small>\n          </a>\n        </li>\n      </ul>\n    </div>\n    <div ui-view class=\"body-info-menu\"></div>\n    <button class=\"btn-hide-sidebar\" ng-class=\"{'collapsed': sidebarBehavior, 'btn-hide-sidebar-bing-layout': bingLayerOn}\" ng-click=\"sidebarCollapsed()\">\n      <i class=\"fa fa-chevron-left\" ng-if=\"!sidebarBehavior\"></i>\n      <i class=\"fa fa-chevron-right\" ng-if=\"sidebarBehavior\"></i>\n    </button>\n  </div>\n</section>\n<version-verifier url=\"{{versionUrl}}\" version=\"1.4.2\"></version-verifier>\n"
          },
