          "content": {
            "size": 19836,
            "mimeType": "text/html",
            "text": "<section class=\"editor\" ng-controller=\"PaEquationIDEController\" ng-show=\"showBlockEditor\" ng-class=\"{'show-editor': showBlockEditor, 'sidebar-collapsed': sidebarBehavior, 'editor-behind': amIBehind}\">\n  <div class=\"group-variables\">\n    <ul class=\"variables-tab nav nav-tabs\">\n      <li title=\"Fertilidade\" role=\"presentation\" ng-click=\"changeMenuVariablesOption('fertility')\" class=\"variable-tab\" ng-class=\"{'selected': showFertilities}\">\n        <a ng-click=\"getFertilities()\">Fert</a>\n      </li>\n      <li title=\"Foliar\" role=\"presentation\" ng-click=\"changeMenuVariablesOption('leaf')\" class=\"variable-tab\" ng-class=\"{'selected': showLeafs}\">\n        <a ng-click=\"getLeafs()\">Foliar</a>\n      </li>\n      <li title=\"Permanente\" role=\"presentation\" ng-click=\"changeMenuVariablesOption('permanent')\" class=\"variable-tab\" ng-class=\"{'selected': showPermanents}\">\n        <a ng-click=\"getPermanents()\">Perm</a>\n      </li>\n      <li title=\"Produtividade\" role=\"presentation\" ng-click=\"changeMenuVariablesOption('productivity')\" class=\"variable-tab\" ng-class=\"{'selected': showProductivities}\">\n        <a ng-click=\"getProductivities()\">Prod</a>\n      </li>\n      <li title=\"Imagem de Satélite\" role=\"presentation\" ng-click=\"changeMenuVariablesOption('satImage')\" class=\"variable-tab\" ng-class=\"{'selected': showSatImages}\">\n        <a ng-click=\"getSatImages()\">Sat</a>\n      </li>\n      <li title=\"Compactação\" role=\"presentation\" ng-click=\"changeMenuVariablesOption('compaction')\" class=\"variable-tab\" ng-class=\"{'selected': showCompactions}\">\n        <a ng-click=\"getCompactions()\">Comp</a>\n      </li>\n      <li title=\"Álgebra\" role=\"presentation\" ng-click=\"changeMenuVariablesOption('algebra')\" class=\"variable-tab\" ng-class=\"{'selected': showAlgebras}\">\n        <a ng-click=\"getAlgebras()\">Alg</a>\n      </li>\n      <li title=\"Praga\" role=\"presentation\" ng-click=\"changeMenuVariablesOption('pest')\" class=\"variable-tab\" ng-class=\"{'selected': showPests}\">\n        <a ng-click=\"getPests()\">Praga</a>\n      </li>\n      <li ng-if=\"canIAccessElectricConductivityData\" title=\"Cond Ele\" role=\"presentation\" ng-click=\"changeMenuVariablesOption('electric_conductivity')\" class=\"variable-tab\" ng-class=\"{'selected': showElectricConductivity}\">\n        <a ng-click=\"getElectricsConductivities()\">Cond Ele</a>\n      </li>\n      <li title=\"Recomendação\" role=\"presentation\" ng-click=\"changeMenuVariablesOption('recommendation')\" class=\"variable-tab\" ng-class=\"{'selected': showRecommendations}\" ng-if=\"showRecommendationsTab\">\n        <a ng-click=\"getRecommendations()\">Rec</a>\n      </li>\n      <li title=\"Constantes\" role=\"presentation\" ng-click=\"changeMenuVariablesOption('constant')\" class=\"variable-tab\" ng-class=\"{'selected': showConstants}\" ng-if=\"showConstantsTab\">\n        <a>Cons</a>\n      </li>\n      <li title=\"Funções\" role=\"presentation\" ng-click=\"changeMenuVariablesOption('function')\" class=\"variable-tab\" ng-class=\"{'selected': showFunctions}\">\n        <a ng-click=\"getFunctions()\">Func</a>\n      </li>\n\n      <li>\n        <button class=\"toggle-variables\" title=\"{{visualizeVariablesType ? 'Fechar Variáveis' : 'Abrir Variáveis'}}\" ng-click=\"showVariableTypes()\">\n          <i class=\"fa\" ng-class=\"{'fa-chevron-up': !visualizeVariablesType, 'fa-chevron-down': visualizeVariablesType}\"></i>\n        </button>\n      </li>\n\n      <li class=\"actions-editor pull-right\">\n        <button class=\"btn btn-xs editor-size\" title=\"{{editorMinimized ? 'Reataurar Janela' : 'Encolher Janela'}}\" ng-show=\"true\" ng-click=\"togleEditorSize('minimize')\">\n          <span class=\"fa\" ng-class=\"{'fa-window-minimize': !editorMinimized, 'fa-window-restore': editorMinimized}\"></span>\n        </button>\n\n        <button class=\"btn btn-xs editor-size\" title=\"{{editorExpanded ? 'Restaurar Janela' : 'Expandir Janela'}}\" ng-show=\"true\" ng-click=\"togleEditorSize('expand')\">\n          <span class=\"fa\" ng-class=\"{'fa-window-maximize': !editorExpanded, 'fa-window-restore': editorExpanded}\"></span>\n        </button>\n\n        <!--TODO: se sentirem falta, refazemos pq não tá funcionando -->\n        <!--div class=\"icon-move\" id=\"move-element-editor\">\n          <i title=\"Mover Editor\" class=\"fa fa-arrows-alt\" aria-hidden=\"true\"></i>\n        </div-->\n\n        <button class=\"btn btn-danger btn-xs close-editor\" title=\"Fechar Editor\" ng-click=\"closeEditor()\">\n          <span class=\"fa fa-times\"></span>\n        </button>\n      </li>\n\n      <li class=\"box-validation pull-right\">\n        <button title=\"Validar Sintaxe\" class='button-validate-equation' ng-click=\"validateEquation()\" ng-show=\"!loadingValidation\">Validar Sintaxe</button>\n        <i class=\"fa fa-check check-green\" aria-hidden=\"true\" ng-show=\"!loadingValidation && (!lastValidation.hasError && !lastValidation.isExpired)\"></i>\n        <i class=\"fa fa-exclamation exclamation-red\" aria-hidden=\"true\" ng-show=\"!loadingValidation &&  (lastValidation.hasError && !lastValidation.isExpired)\"></i>\n        <loader loading=\"loadingValidation\" size=\"extra-small\"></loader>\n      </li>\n    </ul>\n\n    <div class=\"variables-type\" ng-class=\"{'expanded': visualizeVariablesType}\">\n      <loader loading=\"loading || (showFertilities && isLoadingFertilities)\" size=\"small\"></loader>\n\n      <div ng-if=\"showRecommendations\" ng-show=\"!loading\">\n        <div ng-if=\"!hasError && !hasRecommendations\" ng-show=\"!loading\">\n          <div class=\"msg-info\">\n            Você ainda não possui Recomendações.\n          </div>\n        </div>\n        <div ng-if=\"hasError\" ng-show=\"!loading\">\n          <div class=\"msg-info\">\n            Ops! Não conseguimos listar suas Recomendações, atualize a página ou entre em contato com nosso suporte!\n          </div>\n        </div>\n        <ul class=\"variables-type-tab nav nav-tabs\">\n          <li role=\"presentation\" ng-repeat=\"rec in recommendations\" ng-class=\"{'selected': rec.id === selectedVariableTypeTabId}\">\n            <a ng-click=\"selectVariableTypeTabId(rec.id)\">{{rec.nome}}</a>\n          </li>\n        </ul>\n        <div class=\"scroll\">\n          <div ng-repeat=\"rec in recommendations\">\n            <div ng-repeat=\"product in rec.produtos\" ng-if=\"rec.id === selectedVariableTypeTabId\">\n              <div class=\"variables\" ng-if=\"product.calculado === 'Calculado'\">\n                <a ng-click=\"addRecommendationVariableToEditor(product)\" title=\"{{product.nome}}\">{{product.nome | limitWithEllipsis: 7}}</a>\n              </div>\n              <div class=\"variables\" ng-if=\"product.calculado !== 'Calculado'\">\n                <span class=\"uncalculated-rec\"> {{product.nome | limitWithEllipsis: 7}} - Não Calc.</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div ng-if=\"showFunctions\" ng-show=\"!loading\">\n        <div class=\"scroll\">\n          <div class=\"variables\" ng-repeat=\"function in functions\">\n            <button class=\"btn btn-default\" ng-click=\"addFunctionToEditor(function.functionText)\" title=\"{{function.screenText}}\">{{function.screenText}}</button>\n          </div>\n        </div>\n      </div>\n\n      <div ng-if=\"showAlgebras\" ng-show=\"!loading\">\n        <div ng-if=\"!hasError && !hasAlgebras\" ng-show=\"!loading\">\n          <div class=\"msg-info\">\n            Você ainda não possui Álgebras.\n          </div>\n        </div>\n        <div ng-if=\"hasError\" ng-show=\"!loading\">\n          <div class=\"msg-info\">\n            Ops! Não conseguimos listar suas Álgebras, atualize a página ou entre em contato com nosso suporte!\n          </div>\n        </div>\n        <div class=\"scroll\">\n          <div class=\"variables\" ng-repeat=\"algebra in algebras\">\n            <div class=\"btn-group\" role=\"group\" aria-label=\"...\">\n              <button class=\"btn btn-default\" ng-click=\"addAlgebraVariableToEditor(algebra)\" title=\"{{algebra.nome}}\">{{algebra.nome | limitWithEllipsis: 7}}</button>\n              <interpolation-map-button ng-if=\"canISeeInterpolationMaps\" interpolation=\"algebra\" has-grid=\"false\" title=\"Visualizar mapa do álgebra de mapas\"></interpolation-map-button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div ng-if=\"showPests\" ng-show=\"!loading\">\n        <div ng-if=\"!hasError && !hasPests\" ng-show=\"!loading\">\n          <div class=\"msg-info\">\n            Você ainda não possui Pragas.\n          </div>\n        </div>\n        <div ng-if=\"hasError\" ng-show=\"!loading\">\n          <div class=\"msg-info\">\n            Ops! Não conseguimos listar suas Pragas, atualize a página ou entre em contato com nosso suporte!\n          </div>\n        </div>\n        <div class=\"scroll\">\n          <div class=\"variables\" ng-repeat=\"pest in pests\">\n            <div class=\"btn-group\" role=\"group\" aria-label=\"...\">\n              <button class=\"btn btn-default\" ng-click=\"addPestVariableToEditor(pest)\" title=\"{{pest.nome}}\">{{pest.nome | limitWithEllipsis: 7}}</button>\n              <interpolation-map-button ng-if=\"canISeeInterpolationMaps\" interpolation=\"pest\" has-grid=\"false\" title=\"Visualizar mapa de índice de vegetação\"></interpolation-map-button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div ng-if=\"showElectricConductivity\" ng-show=\"!loading\">\n        <div ng-if=\"!hasError && !hasElectricsConductivities\" ng-show=\"!loading\">\n          <div class=\"msg-info\">\n            Você ainda não possui Condutividades Elétricas.\n          </div>\n        </div>\n        <div ng-if=\"hasError\" ng-show=\"!loading\">\n          <div class=\"msg-info\">\n            Ops! Não conseguimos listar suas Condutividades Elétricas, atualize a página ou entre em contato com nosso suporte!\n          </div>\n        </div>\n        <div class=\"scroll\">\n          <div class=\"variables\" ng-repeat=\"electricConductivity in electricsConductivities\">\n            <div class=\"btn-group\" role=\"group\" aria-label=\"...\">\n              <button class=\"btn btn-default\" ng-click=\"addElectricConductivityVariableToEditor(electricConductivity)\" title=\"{{electricConductivity.nome}}\">{{electricConductivity.nome | limitWithEllipsis: 7}}</button>\n              <interpolation-map-button ng-if=\"canISeeInterpolationMaps\" interpolation=\"electricConductivity\" has-grid=\"false\" title=\"Visualizar mapa de condutividade elétrica\"></interpolation-map-button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div ng-if=\"showPermanents\" ng-show=\"!loading\">\n        <div ng-if=\"!hasError && !hasPermanents\" ng-show=\"!loading\">\n          <div class=\"msg-info\">\n            Você ainda não possui Permanentes.\n          </div>\n        </div>\n        <div ng-if=\"hasError\" ng-show=\"!loading\">\n          <div class=\"msg-info\">\n            Ops! Não conseguimos listar seus Permanentes, atualize a página ou entre em contato com nosso suporte!\n          </div>\n        </div>\n        <div class=\"scroll\">\n          <div class=\"variables\" ng-repeat=\"permanent in permanents\">\n            <div class=\"btn-group\" role=\"group\" aria-label=\"...\">\n              <button class=\"btn btn-default\" ng-click=\"addPermanentVariableToEditor(permanent)\" title=\"{{permanent.nome}}\">{{permanent.nome | limitWithEllipsis: 10}}</button>\n              <interpolation-map-button ng-if=\"canISeeInterpolationMaps\" interpolation=\"permanent\" has-grid=\"permanent.nome !== 'Altimetria SRTM'\" title=\"Visualizar mapa do permanente\"></interpolation-map-button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div ng-if=\"showFertilities\" ng-show=\"!loading && !isLoadingFertilities\">\n        <div ng-if=\"!hasFertilitiesLoadFailed && !hasFertilities\">\n          <div class=\"msg-info\">\n            Você ainda não possui Fertilidades.\n          </div>\n        </div>\n        <div ng-if=\"hasFertilitiesLoadFailed\">\n          <div class=\"msg-info\">\n            Ops! Não conseguimos listar suas Fertilidades, atualize a página ou entre em contato com nosso suporte!\n          </div>\n        </div>\n        <ul class=\"variables-type-tab nav nav-tabs\">\n          <li role=\"presentation\" ng-repeat=\"(fertilityInitials, groupFertilityElement) in groupFertilitiesElements\" ng-class=\"{'selected': fertilityInitials === selectedVariableTypeTabName}\">\n            <a ng-click=\"selectVariableTypeTabName(fertilityInitials)\">{{fertilityInitials}}</a>\n          </li>\n        </ul>\n        <div class=\"scroll\">\n          <div ng-repeat=\"(fertilityInitials, groupFertilityElement) in groupFertilitiesElements\">\n            <div class=\"variables\" ng-repeat=\"fertility in groupFertilityElement\" ng-if=\"fertility.sigla === selectedVariableTypeTabName\">\n              <div class=\"btn-group\" role=\"group\" aria-label=\"...\">\n                <button class=\"btn btn-default\" ng-click=\"addFertilityVariableToEditor(fertility)\" title=\"{{fertility.nome}}\">{{fertility.profundidade | limitWithEllipsis: 7}}</button>\n                <interpolation-map-button ng-if=\"canISeeInterpolationMaps\" interpolation=\"fertility\" has-grid=\"true\" title=\"Visualizar mapa da fertilidade\"></interpolation-map-button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div ng-if=\"showLeafs\" ng-show=\"!loading\">\n        <div ng-if=\"!hasError && !hasLeafs\" ng-show=\"!loading\">\n          <div class=\"msg-info\">\n            Você ainda não possui Foliares.\n          </div>\n        </div>\n        <div ng-if=\"hasError\" ng-show=\"!loading\">\n          <div class=\"msg-info\">\n            Ops! Não conseguimos listar seus Foliares, atualize a página ou entre em contato com nosso suporte!\n          </div>\n        </div>\n        <div class=\"scroll\">\n          <!-- Mapa foliar de grade carrega o terco no nome ('N/Ca (terço\n               baixo)'): o limite curto tornava os tres tercos identicos no\n               botao, e a ordem do backend agrupa elemento e terco. -->\n          <div class=\"variables\" ng-repeat=\"leaf in leafs | orderBy: 'order'\">\n            <div class=\"btn-group\" role=\"group\" aria-label=\"...\">\n              <button class=\"btn btn-default\" ng-click=\"addLeafVariableToEditor(leaf)\" title=\"{{leaf.nome}}\">{{leaf.nome | limitWithEllipsis: 22}} ({{leaf.unit}})</button>\n              <interpolation-map-button ng-if=\"canISeeInterpolationMaps\" interpolation=\"leaf\" has-grid=\"false\" title=\"Visualizar mapa de foliares\"></interpolation-map-button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div ng-if=\"showSatImages\" ng-show=\"!loading\">\n        <div ng-if=\"!hasError && !hasSatImages\" ng-show=\"!loading\">\n          <div class=\"msg-info\">\n            Você ainda não possui Imagens de Satélite.\n          </div>\n        </div>\n        <div ng-if=\"hasError\" ng-show=\"!loading\">\n          <div class=\"msg-info\">\n            Ops! Não conseguimos listar suas Imagens de Satélite, atualize a página ou entre em contato com nosso suporte!\n          </div>\n        </div>\n        <div class=\"scroll\">\n          <div class=\"variables\" ng-if=\"hasSatImages\">\n            <button class=\"btn btn-default\" ng-click=\"addNewestNDVIToEditor()\">NDVI - Mais Recente</button>\n          </div>\n          <div ng-repeat=\"satImage in satImages\">\n            <div class=\"variables\" ng-repeat=\"index in satImage.products\" ng-if=\"index.descricao !== 'RGB'\">\n              <div class=\"btn-group\" role=\"group\" aria-label=\"...\">\n                <button class=\"btn btn-default\" ng-click=\"addSatIndexVariableToEditor(index)\" title=\"{{satImage.nome}}\">{{index.descricao | limitWithEllipsis: 10}} - {{satImage.date}}</button>\n                <interpolation-map-button ng-if=\"canISeeInterpolationMaps\" interpolation=\"index\" has-grid=\"false\" title=\"Visualizar mapa de índice de vegetação\"></interpolation-map-button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div ng-if=\"showCompactions\" ng-show=\"!loading\">\n        <div ng-if=\"!hasError && !hasCompactions\" ng-show=\"!loading\">\n          <div class=\"msg-info\">\n            Você ainda não possui Compactações.\n          </div>\n        </div>\n        <div ng-if=\"hasError\" ng-show=\"!loading\">\n          <div class=\"msg-info\">\n            Ops! Não conseguimos listar suas Compactações, atualize a página ou entre em contato com nosso suporte!\n          </div>\n        </div>\n        <ul class=\"variables-type-tab nav nav-tabs\">\n          <li role=\"presentation\" ng-repeat=\"compaction in compactions\" ng-class=\"{'selected': compaction.id === selectedVariableTypeTabId}\">\n            <a ng-click=\"selectVariableTypeTabId(compaction.id)\">{{compaction.nome}}</a>\n          </li>\n        </ul>\n        <div class=\"scroll\">\n          <div class=\"variables\" ng-if=\"hasCompactions\">\n            <a ng-click=\"addNewestCriticalVariableToEditor()\">Crít. - Mais Recente</a>\n          </div>\n          <div class=\"variables\" ng-if=\"hasCompactions\">\n            <a ng-click=\"addNewestDepthVariableToEditor()\">Prof. - Mais Recente</a>\n          </div>\n            <div ng-repeat=\"compaction in compactions\">\n              <div class=\"variables\"  ng-repeat=\"compactionLayer in compaction.compactations\" ng-if=\"compaction.id === selectedVariableTypeTabId && compactionLayer.tipo != null\">\n                <div class=\"btn-group\" role=\"group\" aria-label=\"...\">\n                  <button class=\"btn btn-default\" ng-click=\"addCompactionLayerVariableToEditor(compaction.id, compactionLayer.tipo === 'critico')\" title=\"{{compactionLayer.nome}}\">{{compactionLayer.nome}}</button>\n                  <interpolation-map-button ng-if=\"canISeeInterpolationMaps\" interpolation=\"compactionLayer\" has-grid=\"false\" title=\"Visualizar mapa de compactação\"></interpolation-map-button>\n                </div>\n              </div>\n            </div>\n        </div>\n      </div>\n\n      <div ng-if=\"showProductivities\" ng-show=\"!loading\">\n        <div ng-if=\"!hasError && !hasProductivities\" ng-show=\"!loading\">\n          <div class=\"msg-info\">\n            Você ainda não possui mapas de produtividade.\n          </div>\n        </div>\n        <div ng-if=\"hasError\" ng-show=\"!loading\">\n          <div class=\"msg-info\">\n            Ops! Não conseguimos listar suas Produtividades, atualize a página ou entre em contato com nosso suporte!\n          </div>\n        </div>\n        <div class=\"scroll\">\n          <div class=\"variables col-md-4\" ng-if=\"hasProductivities\">\n            <a ng-click=\"addNewestProductivityToEditor()\">Prod. - Mais Recente</a>\n          </div>\n          <div class=\"variables\" ng-repeat=\"productivity in productivities\">\n            <div class=\"btn-group\" role=\"group\" aria-label=\"...\">\n              <button class=\"btn btn-default\" ng-click=\"addProductivityVariableToEditor(productivity)\" title=\"{{productivity.nome}}\">{{productivity.nome| limitWithEllipsis: 7}} - {{productivity.date}}</button>\n              <interpolation-map-button ng-if=\"canISeeInterpolationMaps\" interpolation=\"productivity\" has-grid=\"false\" title=\"Visualizar mapa de produtividade\"></interpolation-map-button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div ng-if=\"showConstants\" ng-show=\"!loading\">\n        <div class=\"scroll\">\n          <div class=\"msg-info\" ng-if=\"constants.length < 1\">\n            Você ainda não possui Constantes.\n          </div>\n          <div class=\"variables\" ng-if=\"constants.length >= 1\" ng-repeat=\"constant in constants\">\n            <button class=\"btn btn-default\" title=\"{{constant.constante}}\" ng-click=\"addConstantVariableToEditor(constant.constante)\">{{constant.constante | limitWithEllipsis: 10}}</button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"editor-component\">\n    <section>\n      <div class=\"ace-area\" ng-class=\"{'expanded': editorExpanded, 'minimized': editorMinimized}\" ui-ace=\"aceOption\" ng-readonly=\"false\" ng-model=\"equation\"></div>\n    </section>\n  </div>\n</section>\n<version-verifier url=\"{{versionUrl}}\" version=\"1.4.2\"></version-verifier>\n"
