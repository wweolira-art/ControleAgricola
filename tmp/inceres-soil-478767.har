          "cookies": [],
          "content": {
            "size": 3469,
            "mimeType": "text/html",
            "text": "<div ng-controller=\"CarEditionController\" >\n  <div ng-if=\"showEditionPanel\" ng-class=\"workingOn === 'grid' ? 'edition-actions-panel-div' : 'edition-actions-panel-div-ugd'\">\n    <div class=\"edition-actions-buttons\">\n      <button type=\"button\" class=\"edition-action-button hi-icon-effect-4-moving\"\n              ng-class=\"{'hi-icon-effect-4b-moving': movingPoints === true, 'hi-icon-effect-4a-moving': movingPoints === false}\"\n              title=\"Mover um ponto de lugar dentro do talhão.\" aria-pressed=\"{{ !!movingPoints }}\" ng-click=\"startEditingPieces()\">\n        <span class=\"hi-icon fa fa-arrows\" ng-class=\"{'activated moving-on': movingPoints}\" aria-hidden=\"true\"></span>\n      </button>\n      <button type=\"button\" ng-if=\"workingOn === 'grid' || workingOn === 'random-chassis-grid'\" class=\"edition-action-button hi-icon-effect-4-adding\"\n              ng-class=\"{'hi-icon-effect-4b-adding': addingPoints === true, 'hi-icon-effect-4a-adding': addingPoints === false}\"\n              title=\"Adicionar um ponto no talhão.\" aria-pressed=\"{{ !!addingPoints }}\" ng-click=\"startAddingPieces()\">\n        <span class=\"hi-icon fa fa-plus\" ng-class=\"{'activated adding-on': addingPoints}\" aria-hidden=\"true\"></span>\n      </button>\n      <button type=\"button\" ng-if=\"workingOn === 'grid' || workingOn === 'random-chassis-grid'\" class=\"edition-action-button hi-icon-effect-4-removing\"\n              ng-class=\"removingPoints === true ? 'hi-icon-effect-4b-removing' : 'hi-icon-effect-4a-removing'\"\n              title=\"Remover um ponto do talhão.\" aria-pressed=\"{{ !!removingPoints }}\" ng-click=\"startRemovePieces()\">\n        <span class=\"hi-icon fa fa-trash\" ng-class=\"{'activated removing-on': removingPoints}\" aria-hidden=\"true\"></span>\n      </button>\n      <button type=\"button\" ng-if=\"canIUseGridOverLayer && workingOn === 'grid'\" class=\"edition-action-button hi-icon-effect-4-insulfilm\"\n              ng-class=\"showOptionsToGetinsulfilm === true ? 'hi-icon-effect-4b-insulfilm' : 'hi-icon-effect-4a-insulfilm'\"\n              title=\"Visualizar camadas de apoio à decisão\" aria-expanded=\"{{ !!showOptionsToGetinsulfilm }}\" ng-click=\"showInsulfilmsOptions()\">\n        <span class=\"hi-icon fa\" ng-class=\"{'fa-cog fa-spin': findingInsulfilms, 'fa-map': !findingInsulfilms, 'activated': showOptionsToGetinsulfilm}\" aria-hidden=\"true\"></span>\n      </button>\n      <button type=\"button\" ng-if=\"workingOn === 'grid'\" class=\"edition-action-button hi-icon-effect-4-sort-options\"\n              ng-class=\"showSortOptions === true ? 'hi-icon-effect-4b-sort-options' : 'hi-icon-effect-4a-sort-options'\"\n              title=\"Visualizar opções de ordenação\" aria-pressed=\"{{ !!showSortOptions }}\" ng-click=\"toggleSortOptions()\">\n        <span class=\"hi-icon fa fa-sort-numeric-asc\" ng-class=\"{'activated': showSortOptions}\" aria-hidden=\"true\"></span>\n      </button>\n    </div>\n  </div>\n\n  <div class=\"types-of-insulfilms\" ng-if=\"showOptionsToGetinsulfilm\">\n    <label class=\"support-layer-option\" ng-repeat=\"(key, value) in availableInsulfilms\">\n      <input type=\"checkbox\" ng-model=\"value.selected\">\n      <span class=\"support-layer-option-box\" aria-hidden=\"true\"></span>\n      <span class=\"support-layer-option-label\" ng-bind=\"::value.label\"></span>\n    </label>\n    <button type=\"button\" class=\"support-layers-search-button\" ng-click=\"findAvaliableInsulfilms()\">Buscar</button>\n  </div>\n</div>\n<version-verifier url=\"{{versionUrl}}\" version=\"2.1.0\" notify-outside=\"true\"/>\n"
          },
