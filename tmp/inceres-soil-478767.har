          "content": {
            "size": 2447,
            "mimeType": "text/html",
            "text": "<div class=\"container-fluid\" ng-controller=\"InsulfilmController\">\n\n  <section class=\"support-layers-card\" ng-hide=\"ndvibarCollapsed\" ng-if=\"showTimeLine\" aria-label=\"Camadas de apoio à decisão\">\n    <div class=\"support-layers-header\">\n      <label class=\"support-layers-transparency-label\" for=\"support-layers-transparency\">Transparência:</label>\n      <input id=\"support-layers-transparency\" class=\"support-layers-transparency\" type=\"range\" min=\"0\" max=\"{{ ::maxTransparencyPercent }}\" step=\"1\"\n             ng-model=\"transparency.percent\" ng-style=\"buildTransparencyTrackStyle()\" aria-valuetext=\"{{ transparency.percent }}% de transparência\">\n      <span class=\"support-layers-transparency-value\">{{ transparency.percent }}%</span>\n      <button type=\"button\" class=\"support-layers-close\" ng-click=\"closeSupportLayers()\" title=\"Fechar\" aria-label=\"Fechar camadas de apoio\">\n        <i class=\"fa fa-times\" aria-hidden=\"true\"></i>\n      </button>\n    </div>\n\n    <div class=\"support-layers-tabs\" role=\"tablist\">\n      <button type=\"button\" role=\"tab\" class=\"support-layers-tab\" ng-repeat=\"layerType in layerTypes\"\n              ng-class=\"{'selected': isActiveLayerType(layerType)}\" aria-selected=\"{{ isActiveLayerType(layerType) }}\"\n              aria-controls=\"support-layers-thumbs\" ng-click=\"selectLayerType(layerType)\" ng-bind=\"describeLayerType(layerType)\"></button>\n    </div>\n\n    <div id=\"support-layers-thumbs\" role=\"tabpanel\" aria-label=\"{{ describeLayerType(activeLayerType) }}\">\n      <ul class=\"support-layers-thumbs\" wheel-scrolls-horizontally>\n        <li ng-repeat=\"layer in timeline[activeLayerType]\">\n          <button type=\"button\" class=\"support-layer-thumb\" ng-class=\"{'selected': layer.selected}\" aria-pressed=\"{{ !!layer.selected }}\"\n                  ng-click=\"putTheInsulfilm(layer, activeLayerType)\">\n            <span class=\"support-layer-thumb-image\">\n              <img ng-src=\"{{ layer.url }}\" alt=\"\" ng-if=\"hasPreview(activeLayerType)\">\n              <img src=\"/img/no-preview.png\" alt=\"\" title=\"Sem pré-visualização\" ng-if=\"!hasPreview(activeLayerType)\">\n            </span>\n            <span class=\"support-layer-thumb-caption\">\n              <span class=\"support-layer-thumb-caption-text\" ng-bind=\"describeLayer(layer)\"></span>\n            </span>\n          </button>\n        </li>\n      </ul>\n    </div>\n  </section>\n</div>\n<version-verifier url=\"{{ versionUrl }}\" version=\"2.1.0\" notify-outside=\"true\"/>\n"
          },
