          "content": {
            "size": 2008,
            "mimeType": "text/html",
            "text": "<div ng-controller=\"CarPrototypePatternController\" class=\"new-sampling-modal navy-heading-modal save-pattern-modal\" ng-class=\"{'opened': modalCarPrototypePatternIsOpen}\">\n  <form name=\"importForm\" class=\"modal-view\" novalidate ng-submit=\"submitForm(importForm)\">\n    <div class=\"modal-heading\">\n      <div class=\"title-row\">\n        <span class=\"title\">Enviar como Padrão para a biblioteca</span>\n        <button type=\"button\" class=\"close-button\" ng-click=\"closeModal()\" title=\"Fechar\" aria-label=\"Fechar\">\n          <i class=\"fa fa-times\" aria-hidden=\"true\"></i>\n        </button>\n      </div>\n    </div>\n\n    <div class=\"modal-body custom-scroll\">\n      <progress loading=\"carPrototypeIsLoading\" class=\"loading-importing-spinner loading-car-prototype-pattern\"></progress>\n\n      <div ng-if=\"!carPrototypeIsLoading\">\n        <p class=\"pattern-subtitle\">Salve esta grade como um padrão reutilizável na sua biblioteca</p>\n\n        <div class=\"pattern-field\">\n          <label class=\"pattern-label\" for=\"carPatternName\">Nome</label>\n          <input type=\"text\" id=\"carPatternName\" name=\"name\" class=\"pattern-input\" placeholder=\"Padrão de Amostragem\"\n                 ng-model=\"carPrototypePattern.name\" required>\n        </div>\n\n        <div class=\"pattern-field\">\n          <label class=\"pattern-label\" for=\"carPatternDescription\">Descrição (Opcional)</label>\n          <textarea id=\"carPatternDescription\" class=\"pattern-input pattern-textarea\"\n                    placeholder=\"Aqui você pode inserir uma descrição para o seu padrão de grade.\"\n                    ng-model=\"carPrototypePattern.description\"></textarea>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"modal-footer-actions\" ng-if=\"!carPrototypeIsLoading\">\n      <button type=\"button\" class=\"dismiss-button\" ng-click=\"closeModal()\">Cancelar</button>\n      <button type=\"submit\" class=\"confirm-button\">Salvar</button>\n    </div>\n  </form>\n</div>\n<version-verifier url=\"{{versionUrl}}\" version=\"2.1.0\" notify-outside=\"true\"/>\n"
          },
          "redirectURL": "",
          "headersSize": -1,
          "bodySize": 0,
