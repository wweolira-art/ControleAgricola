            "size": 1027,
            "mimeType": "text/html",
            "text": "<div class=\"popup-china-car-name\" ng-class=\"{'opened': chooseAnalysisPreferencesPatternsModalOpen}\">\n  <div class=\"panel panel-default panel-china-car-name-view\">\n    <div class=\"panel-heading\">Selecione o padrão de análise da nova grade</div>\n    <div class=\"panel-body-china-car-name\">\n      <div class=\"form-group\">\n        <label for=\"sel2\">Padrão de Preferências de Análise:</label>\n        <select ng-model=\"analysisPreferencePatternId\" class=\"form-control\" id=\"sel2\" ng-change=\"selectAnalysisPreferencePatternId(analysisPreferencePatternId)\">\n          <option ng-repeat=\"pattern in analysisPreferencesPatterns track by pattern.id\" ng-value=\"pattern.id\">{{pattern.name}}</option>\n        </select>\n      </div>\n    </div>\n    <div class=\"panel-footer\">\n      <button type=\"button\" class=\"btn btn-success\" ng-click=\"mergeAllCars(carsToMerge)\">Unir Amostragens</button>\n      <button type=\"button\" class=\"btn btn-danger\" ng-click=\"closeAnalysisPreferencesPatternsPopup()\">Cancelar</button>\n    </div>\n  </div>\n</div>\n"
          },
