          "content": {
            "size": 14710,
            "mimeType": "text/html",
            "text": "<div ng-controller=\"InfoController\">\n  <section ng-style=\"{display: importSheet ? 'block' : 'none'}\" ng-include=\"'templates/modal-import-sheet.html'\"></section>\n\n  <div class=\"container-fluid tool-info-panel-container\">\n    <div class=\"row nav-bar-row\">\n      <ul class=\"nav nav-tabs\">\n        <li class=\"info-tool-tab active\"><a data-toggle=\"tab\" href=\"#gridInfos\" ng-click=\"shouldShowGridDetails(false)\">Informações</a></li>\n        <li class=\"info-tool-tab\"> <a data-toggle=\"tab\" ng-href=\"#gridDetails\" ng-click=\"shouldShowGridDetails(true)\">Detalhes</a></li>\n      </ul>\n      <button type=\"button\" class=\"close-icon\" ng-click=\"closeInfo()\" aria-label=\"Fechar painel da grade\"><i class=\"fa fa-times\" aria-hidden=\"true\"></i></button>\n    </div>\n\n    <div class=\"row tab-content-row\">\n      <div ng-show=\"!showDetails\" id=\"gridInfos\" class=\"info-panel-tab-content tab-pane fade in active custom-scroll\">\n        <div class=\"tool-info-header row\">\n          <div class=\"col-md-4\"> <label title=\"{{modalCar.id}}\">ID:</label> {{modalCar.id.toString() | limitWithEllipsis:5}} </div>\n          <div class=\"col-md-8\"> <label>Nome:&nbsp</label><span title={{modalCar.model}} ng-bind=\"modalCar.model | limitWithEllipsis:17\"></span> </div>\n          <div class=\"col-md-4\"> <label>Total:</label> {{modalCar.piecesNumber}}</div>\n          <div class=\"col-md-8\"> <label>IDs:</label> {{modalCar.firstId}} até {{modalCar.lastId}}</div>\n        </div>\n\n        <div class=\"row delivery-forecast-row\">\n          <div class=\"col-md-12\">\n            <label>Previsão de entrega:</label>\n            <span ng-bind=\"deliveryForecastLabel()\"></span>\n          </div>\n        </div>\n\n        <hr class=\"row zas-divider-title-infos\">\n\n        <div class=\"row tool-info-select\">\n          <div class=\"col-md-12\">\n            <div class=\"form-group\">\n              <label for=\"sel1\">Status da Amostragem:\n                <field-tooltip text=\"Indica o estágio atual do processo de amostragem.\" placement=\"bottom-right\"></field-tooltip>\n              </label>\n              <select ng-model=\"modalCar.status\" class=\"form-control\" id=\"sel1\">\n                <optgroup ng-repeat=\"phase in statusGroups\" label=\"{{phase.abbr}} - {{phase.label}}\">\n                  <option ng-repeat=\"raw in phase.from\" ng-value=\"raw\">{{raw}}</option>\n                </optgroup>\n              </select>\n            </div>\n          </div>\n        </div>\n\n         <div class=\"row\" ng-if=\"!isLeafSampling()\">\n          <div class=\"col-md-12\">\n            <div class=\"form-group\">\n              <label for=\"sel2\">Padrão de Preferências de Análise:\n                <field-tooltip text=\"Define as unidades dos elementos analisados, a ordem de exibição dos mapas de fertilidade e quais elementos serão apresentados nos relatórios.\" placement=\"bottom-right\"></field-tooltip>\n              </label>\n              <select ng-model=\"modalCar.analysisPreferencePatternId\" ng-options=\"pattern.id as pattern.name for pattern in analysisPreferencesPatterns\" ng-disabled=\"modalCar.piecesInstalled && hasAnalysisPreferencePattern\" class=\"form-control\" id=\"sel2\"></select>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"row\">\n          <div class=\"col-md-12\">\n            <div class=\"form-group\">\n              <label for=\"sel3\">Responsável Financeiro:\n                <field-tooltip text=\"Selecione o responsável pelos custos e pelo faturamento desta amostragem.\" placement=\"bottom-right\"></field-tooltip>\n              </label>\n              <select ng-model=\"modalCar.respFinanceiroSelect\"  ng-disabled=\"modalCar.sold\" class=\"form-control\" id=\"sel3\">\n                <option value=\"\">- selecione -</option>\n                <option ng-repeat=\"user in myUsersList\" ng-value=\"user.id\" >{{user.nome}}</option>\n              </select>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"row\">\n          <div class=\"col-md-12\">\n            <div class=\"form-group\">\n              <label for=\"sel4\">Laboratório:\n                <field-tooltip text=\"Selecione o laboratório onde as amostras coletadas serão enviadas e analisadas.\" placement=\"bottom-right\"></field-tooltip>\n              </label>\n              <select ng-model=\"modalCar.automakerName\" class=\"form-control\" id=\"sel4\">\n                <option value=\"\">- selecione -</option>\n                <option disabled>Laboratórios Integrados</option>\n                <option ng-repeat=\"(lab, key) in labList\">{{lab}}</option>\n                <option disabled>Outras opções</option>\n                <option value=\"Inceres\">Laboratórios não integrados</option>\n              </select>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"row\">\n          <div class=\"col-md-12\">\n            <div class=\"form-group sampler-picker\">\n              <label for=\"contractedDriver\">Amostradores:\n                <field-tooltip text=\"Selecione o amostrador encarregado de realizar a coleta das amostras no campo.\" placement=\"bottom-right\"></field-tooltip>\n              </label>\n              <input type=\"text\" class=\"form-control\" placeholder=\"- selecione -\" autocomplete=\"off\" ng-model=\"samplers.typed\" ng-focus=\"toggleSamplerListVisibile(true)\" ng-blur=\"toggleSamplerListVisibile(false)\" />\n              <div class=\"autocomplete-list\" ng-show=\"samplers.autoCompleteVisble\" ng-mouseover=\"hoveringInSamplerList(true)\" ng-mouseleave=\"hoveringInSamplerList(false)\">\n                <ul class=\"list-group\">\n                  <li class=\"list-group-item\" ng-repeat=\"sampler in samplers.list | filter: samplers.typed as visibleSamplers\" ng-click=\"addSamplerToTheList(sampler)\">\n                    <div class=\"tool-info-sampler-choice\">\n                      {{sampler.name}}\n                      <i class=\"fa fa-mobile-phone\" title=\"{{sampler.hasMobile ? 'Tem App Mobile' : 'Não tem App Mobile'}}\" ng-class=\"{'has-mobile': sampler.hasMobile}\"></i>\n                    </div>\n                  </li>\n                  <li class=\"list-group-item autocomplete-empty\" ng-if=\"visibleSamplers.length === 0\">\n                    <div class=\"tool-info-sampler-choice\">\n                      {{samplers.list.length === 0 ? 'Sem amostradores restantes' : 'Nenhum amostrador encontrado'}}\n                    </div>\n                  </li>\n                </ul>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <ul class=\"samplers-list custom-scroll\">\n          <li class=\"col-md-6\" ng-repeat=\"sampler in modalCar.contractedDrivers\">\n            <div class=\"samplers-list-item\">\n              <span ng-bind=\"sampler.name|limitWithEllipsis:18\" title=\"{{sampler.name}}\"></span>\n              <button class=\"btn-remove-sampler\" type=\"button\" ng-click=\"removeSamplerFromCar(sampler, $index)\"><i class=\"fa fa-remove\"></i></button>\n              <i class=\"fa fa-mobile-phone\" title=\"{{sampler.hasMobile ? 'Tem App Mobile' : 'Não tem App Mobile'}}\" ng-class=\"{'has-mobile': sampler.hasMobile}\"></i>\n            </div>\n          </li>\n        </ul>\n\n        <div class=\"row\" ng-if=\"canISetCarPreferences\">\n          <div class=\"col-md-12\">\n            <label>Preferências:</label>\n            <div class=\"row\">\n              <div class=\"form-group col-sm-6\">\n                <label title=\"Sufixo de ID\">Sufixo de ID:</label>\n                <input type=\"text\" ng-model=\"modalCar.preferences.idSuffix\" class=\"form-control info-top-input\" />\n              </div>\n            </div>\n            <div class=\"preferences-checks-row\">\n              <label class=\"preference-check\" title=\"{{layersLabel()}} no ID?\">\n                <span>{{layersLabel()}} no ID?</span>\n                <input type=\"checkbox\" ng-model=\"modalCar.preferences.showDepthWithId\">\n              </label>\n              <label class=\"preference-check\" title=\"Análise Junto ao Ponto?\">\n                <span>Análise no Ponto?</span>\n                <input type=\"checkbox\" ng-model=\"modalCar.preferences.showAnalysisInPoint\">\n              </label>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div ng-show=\"showDetails\" id=\"gridDetails\" class=\"info-panel-tab-content tab-pane fade\">\n        <div class=\"row tool-info-header\" ng-show=\"modalCar.origin.source === 'batelador'\">\n          <div> <label>Origem:</label> Batelador - {{modalCar.origin.jobName}} (Tarefa #{{modalCar.origin.jobId}})</div>\n        </div>\n\n        <hr ng-show=\"modalCar.origin.source === 'batelador'\" class=\"zas-divider-title-infos\">\n\n        <div class=\"row tool-info-header\" ng-show=\"modalCar.fertilityPattern\">\n          <div> <label>Padrão de Fertilidade:</label> {{modalCar.fertilityPattern.name}}</div>\n          <div> <label>É Seu Padrão Favorito:</label> {{modalCar.fertilityPattern.favorite}}</div>\n          <div> <label>Culturas:</label> {{modalCar.fertilityPattern.culture}}</div>\n          <div ng-show=\"modalCar.fertilityPatternOrigin.source === 'batelador'\"> <label>Aplicado via:</label> Batelador - {{modalCar.fertilityPatternOrigin.jobName}} (Tarefa #{{modalCar.fertilityPatternOrigin.jobId}})</div>\n        </div>\n\n        <hr ng-show=\"modalCar.fertilityPattern\" class=\"zas-divider-title-infos\">\n\n        <div class=\"row tool-info-header\">\n          <label>Pontos por {{layersLabel()}}:</label>\n          <div class=\"form-group\">\n            <div class=\"prof-counter col-md-6\" ng-repeat=\"layerCount in layerCounts\">\n              <label>{{layerCount.label}}: </label> {{layerCount.count}}\n            </div>\n          </div>\n        </div>\n\n        <hr ng-show=\"modalCar.fertilityPattern\" class=\"zas-divider-title-infos\">\n\n        <div class=\"row tool-info-header\" ng-show=\"modalCar.gridPattern\">\n          <div> <label>Padrão da Amostragem:</label> {{modalCar.gridPattern.name}} </div>\n          <div> <label>Unidade:</label> {{modalCar.gridPattern.unity}}</div>\n        </div>\n\n        <hr ng-show=\"modalCar.gridPattern\" class=\"zas-divider-title-infos\">\n\n        <div class=\"row tool-info-header\" ng-class=\"{'row-piece-analysis-max': !modalCar.gridPattern && !modalCar.fertilityPattern, 'row-piece-analysis-min': modalCar.gridPattern && modalCar.fertilityPattern, 'row-piece-analysis-with-grid-pattern': modalCar.gridPattern && !modalCar.fertilityPattern, 'row-piece-analysis-with-fertility-pattern': !modalCar.gridPattern && modalCar.fertilityPattern, 'row-piece-analysis-with-origin': modalCar.origin.source === 'batelador' || (modalCar.fertilityPattern && modalCar.fertilityPatternOrigin.source === 'batelador')}\">\n          <label>Análises dos Pontos:</label>\n          <ul class=\"list-group custom-scroll ul-piece-analysis\">\n            <li class=\"list-group-item\" ng-repeat=\"piece in modalCar.pieces\">\n              <div class=\"piece-analysis-header\">\n                ID: {{piece.displayId}} | {{layersLabel()}}: {{piece.layersSummary}}\n              </div>\n              <div class=\"piece-analysis-layer\" ng-repeat=\"pieceLayer in piece.orderedLayers\">\n                <span class=\"piece-analysis-layer-name\">{{pieceLayer.label}}</span>\n                <span class=\"piece-analysis-layer-values\">{{pieceLayer.analysisLabel}}</span>\n              </div>\n            </li>\n          </ul>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"row action-buttons-row\">\n      <div class=\"col-md-12 mini-icons-wrap mini-icons-effect-9 mini-icons-effect-9b\">\n        <button type=\"button\" class=\"btn-with-icon\" title=\"{{isSavingCar ? 'Salvando...' : 'Salvar'}}\" aria-label=\"{{isSavingCar ? 'Salvando' : 'Salvar'}}\" aria-busy=\"{{isSavingCar}}\" ng-class=\"{'disabled': isSavingCar}\" ng-disabled=\"isSavingCar\" ng-click=\"tunningCar(modalCar)\"><i class=\"mini-icons fa\" ng-class=\"{'fa-floppy-o': !isSavingCar, 'fa-spinner fa-spin': isSavingCar}\"></i></button>\n        <button type=\"button\" class=\"btn-with-icon\" title=\"{{loading ? 'Baixando resultados...' : 'Baixar Resultados'}}\" aria-label=\"{{loading ? 'Baixando resultados' : 'Baixar Resultados'}}\" aria-busy=\"{{loading}}\" ng-if=\"canHandleResults()\" ng-class=\"{'disabled': loading}\" ng-disabled=\"loading\" ng-click=\"downloadResults()\"><i class=\"mini-icons fa\" ng-class=\"{'fa-file-excel-o': !loading, 'fa-spinner fa-spin': loading}\"></i></button>\n\n        <div class=\"dropdown grid-download\" ng-if=\"canHandleResults()\">\n          <button type=\"button\" id=\"dropdownGridDownload\" data-toggle=\"dropdown\" aria-haspopup=\"true\" aria-expanded=\"true\" title=\"Baixar Grade Amostral\" ng-disabled=\"carsBeingDownloaded[modalCar.id]\" class=\"btn-with-icon\" ng-class=\"{'disabled': carsBeingDownloaded[modalCar.id]}\">\n            <i class=\"mini-icons mini-icons-dropdown fa\" ng-class=\"{'fa-file-archive-o': !carsBeingDownloaded[modalCar.id], 'fa-hourglass-half': carsBeingDownloaded[modalCar.id]}\"></i>\n            <span class=\"caret\"></span>\n          </button>\n          <ul class=\"dropdown-menu download-grid-dropmenu\" aria-labelledby=\"dropdownGridDownload\">\n            <li class=\"item-list\" ng-click=\"selectGridPartToDownload('grid', $event)\"><checkbox ng-model=\"gridDownload.grid\" ng-click=\"$event.stopPropagation()\"></checkbox> Shape Grade</li>\n            <li class=\"item-list\" ng-click=\"selectGridPartToDownload('areas', $event)\"><checkbox ng-model=\"gridDownload.areas\" ng-click=\"$event.stopPropagation()\"></checkbox> Shape Areas</li>\n            <li class=\"item-list\" ng-click=\"selectGridPartToDownload('sketch', $event)\"><checkbox ng-model=\"gridDownload.sketch\" ng-click=\"$event.stopPropagation()\"></checkbox> Imagem Croqui</li>\n            <li class=\"item-list\" ng-click=\"selectGridPartToDownload('tags-txt', $event)\"><checkbox ng-model=\"gridDownload.tagsTxt\" ng-click=\"$event.stopPropagation()\"></checkbox> Etiquetas TXT</li>\n            <li class=\"item-list\" ng-click=\"selectGridPartToDownload('tags-docx', $event)\"><checkbox ng-model=\"gridDownload.tagsDocx\" ng-click=\"$event.stopPropagation()\"></checkbox> Etiquetas DOCX</li>\n            <li role=\"separator\" class=\"divider\"></li>\n            <li class=\"item-list with-button\"><button class=\"btn btn-sm btn-default\" ng-click=\"downloadCarZip(modalCar)\"><i class=\"fa fa-download\"></i> Download</button></li>\n          </ul>\n        </div>\n        <section class=\"can-i-interpolate\" ng-if=\"canIInterpolate && canHandleResults()\">\n          <button type=\"button\" title=\"Importar Planilha\" class=\"btn-with-icon import-left\" ng-click=\"uploadSheet(modalCar)\"><i class=\"mini-icons fa fa-cloud-upload\"></i></button>\n          <button type=\"button\" title=\"Elementos Processados\" ng-if=\"modalCar.piecesInstalled\" class=\"btn-with-icon\" ng-click=\"showToolsPanel(modalCar)\"><i class=\"mini-icons fa fa-flask\"></i></button>\n        </section>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<version-verifier url=\"{{versionUrl}}\" version=\"2.1.0\" notify-outside=\"true\"/>\n"
          },
          "redirectURL": "",
          "headersSize": -1,
          "bodySize": 0,
          "_transferSize": 0,
